#!/bin/bash
# Trunk-protection hook (pre-commit half) — the single surviving hook.
# Per .opencode#2490 SC-6: exactly one hook survives — no direct commit to the
# trunk branch. Property-based: the trunk is derived from this repo's own
# origin remote, never hardcoded. Installed by session-init from
# .opencode/hooks/ into each repo's git-dir hooks/.
set -euo pipefail

trunk="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)"
if [ -z "$trunk" ]; then
  trunk="$(git remote show origin 2>/dev/null | sed -n 's/^[[:space:]]*HEAD branch:[[:space:]]*//p' || true)"
fi
if [ -z "$trunk" ]; then
  echo "trunk-hook: could not determine trunk branch (no origin remote configured?) — allowing commit" >&2
  exit 0
fi

branch="$(git branch --show-current)"

# Issue-store carve-out (.opencode#2512): hooks must not police issue-store
# worktrees. Store worktrees commit on the issues-data branch; the gates
# below are written for real repos — the store-path gate misfires there
# because store worktree paths are bare and its exclusion cannot match.
if [ "$branch" = "issues-data" ]; then
  exit 0
fi

if [ "$branch" = "$trunk" ]; then
  echo "" >&2
  echo "BLOCKED: direct commit to trunk branch '$trunk'." >&2
  echo "All changes go through a feature branch and a PR; PRs are merged by humans only." >&2
  echo "Create the feature branch first: git checkout -b feature/<issue>-<slug>" >&2
  exit 1
fi

# Store-path reference gate — tracked files outside the issue store must not
# reference issue-store paths. The store renumbers issues without updating
# dependents, so any such pointer dangles (see .opencode#2506). Excluded:
#   - paths under .issues/ — the store worktree itself
#   - tests-v2/behaviors/fixtures/ — fabricated store content injected into
#     test repos, not references to the real store
# pattern is split across quotes so the gate's own source never matches it
pattern='\.''issues/'"[0-9]"
while IFS= read -r f; do
  case "$f" in
    .issues/*|*/.issues/*) continue ;;
    tests-v2/behaviors/fixtures/*) continue ;;
  esac
  if git show ":$f" 2>/dev/null | grep -nE "$pattern" >/dev/null 2>&1; then
    echo "" >&2
    echo "BLOCKED: staged file '$f' references an issue-store path (matching *$pattern*)." >&2
    echo "Issue-store paths renumber without updating dependents and dangle in fresh clones." >&2
    echo "Spec/issue content lives in the issues-data store; do not point tracked files into it." >&2
    exit 1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

exit 0
