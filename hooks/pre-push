#!/bin/bash
# Trunk-protection hook (pre-push half) — the single surviving hook.
# Per .opencode#2490 SC-6: exactly one hook survives — no direct push to the
# trunk branch. Property-based: the trunk is derived from this repo's own
# origin remote, never hardcoded. Installed by session-init from
# .opencode/hooks/ into each repo's git-dir hooks/.
set -euo pipefail

trunk="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)"
if [ -z "$trunk" ]; then
  trunk="$(git remote show origin 2>/dev/null | sed -n 's/^[[:space:]]*HEAD branch:[[:space:]]*//p' || true)"
fi
if [ -z "$trunk" ]; then
  echo "trunk-hook: could not determine trunk branch (no origin remote configured?) — allowing push" >&2
  exit 0
fi

# stdin refspec lines: <local-ref> SP <local-sha> SP <remote-ref> SP <remote-sha>
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  case "$remote_ref" in
    refs/tags/*) continue ;;  # tag pushes are immutable pointers, not branch updates
  esac
  if [ "$remote_ref" = "refs/heads/$trunk" ]; then
    echo "" >&2
    echo "BLOCKED: push updates trunk branch '$trunk' directly." >&2
    echo "Trunk changes land only through PRs merged by humans." >&2
    status=1
  fi
done

exit "$status"
