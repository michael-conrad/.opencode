{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/floor.md",
    ".opencode/routing.md"
  ],
  "agent": {
    "build": {
      "prompt": "{file:./prompts/default.txt}"
    },
    "plan": {
      "prompt": "{file:./prompts/default.txt}"
    }
  },
  "mcp": {
    "the-notebook-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.13",
        "--with",
        "fastmcp==2.3.3",
        "--with",
        "jupyter_kernel_client==0.9.0",
        "--with",
        "the-notebook-mcp==0.9.0",
        "python",
        "-c",
        "import os, sys\nimport the_notebook_mcp.core.branding as branding\nbranding.get_server_startup_message = lambda config: 'the-notebook-mcp %s ready (stdio); root dirs: %s' % (config.version, ', '.join(config.allow_root_dirs))\nfrom the_notebook_mcp.server import main\nsys.argv = ['the-notebook-mcp', 'start', '--allow-root', os.environ.get('PWD') or os.getcwd(), '--transport', 'stdio']\nmain()"
      ],
      "enabled": true
    },
    "editor": {
      "type": "local",
      "command": ["uvx", "--from", "git+https://github.com/michael-conrad/viewport-editor@v0.5.0", "viewport-editor"],
      "enabled": true
    },
    "ragsync": {
      "type": "local",
      "command": ["uvx", "--with", "mcp<2", "ragsync", "--config", ".opencode/ragsync-config.yaml"],
      "enabled": true
    },
    "ollama-web-search": {
      "type": "local",
      "command": ["uv", "run", ".opencode/tools/web-search-mcp.py"],
      "enabled": true,
      "environment": {
        "OLLAMA_API_KEY": "{env:OLLAMA_API_KEY}"
      }
    }
  },
  "permission": {
    "gmail_*": "deny",
    "math_*": "deny",
    "the-notebook-mcp_*": "deny"
  },
  "plugin": []
}
