{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/floor.md",
    ".opencode/routing.md"
  ],
  "agent": {
    "build": {
      "prompt": "{file:./prompts/default.txt}"
    },
    "plan": {
      "prompt": "{file:./prompts/default.txt}"
    }
  },
  "mcp": {
    "the-notebook-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "fastmcp==2.3.3",
        "the-notebook-mcp",
        "start",
        "--allow-root",
        "{env:PWD}",
        "--transport",
        "stdio"
      ],
      "enabled": true
    },
    "editor": {
      "type": "local",
      "command": ["uvx", "--from", "git+https://github.com/michael-conrad/viewport-editor@v0.5.0", "viewport-editor"],
      "enabled": true
    },
    "ragsync": {
      "type": "local",
      "command": ["uvx", "--with", "mcp<2", "ragsync", "--config", ".opencode/ragsync-config.yaml"],
      "enabled": true
    }
  },
  "plugin": []
}
