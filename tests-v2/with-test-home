#!/bin/bash
# with-test-home — Run a command in an isolated XDG environment for opencode testing.
#
# Creates a project-relative temporary home directory with clean XDG state,
# eliminating SQLite session conflicts between opencode desktop and CLI.
#
# Usage:
#   bash .opencode/tests-v2/with-test-home <command> [args...]
#   bash .opencode/tests-v2/with-test-home --setup
#   bash .opencode/tests-v2/with-test-home --clean
#   bash .opencode/tests-v2/with-test-home --clean-all
#   bash .opencode/tests-v2/with-test-home --keep <command> [args...]   (default)
#
# Options:
#   --setup      Create test home, seed config, run smoke tests, print TEST_HOME=<path>
#   --keep       Preserve test home after execution (default)
#   --clean      Remove the most recent test home directory
#   --clean-all  Remove ALL test home directories under tmp/
#
# Exit codes:
#   0  - Command succeeded (or clean succeeded)
#   1  - Script error or command failed
#   2  - Usage error
#
# Environment variable isolation — uses env -i with ONLY the minimal,
# explicitly enumerated infrastructure set:
#   HOME, PATH, XDG_CONFIG_HOME, XDG_CACHE_HOME, XDG_RUNTIME_DIR,
#   XDG_DATA_HOME, XDG_STATE_HOME, SHELL, USER, LOGNAME, LANG, TERM,
#   GIT_CONFIG_NOSYSTEM, SNAP_USER_DATA, SNAP_USER_COMMON,
#   and the test-provisioned BEHAVIOR_* opt-in flags.
# USER is set to "opencode-test-user" in the test environment.
# All other values (GitBucket token/host/port, model, config) are set by
# the test harness provisioning itself, never inherited from the parent shell.
#
# SNAP_USER_DATA/SNAP_USER_COMMON override snap's hardcoded ~/snap/opencode/
# to redirect state to the test home instead of the production DB.
#
# FORBIDDEN: parent-sourced GitBucket credentials, GITHUB_TOKEN, GH_TOKEN,
#            OPENCODE_CONFIG_CONTENT, NODE_ENV,
#            VIRTUAL_ENV, CONDA_DEFAULT_ENV, shell-specific vars

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"
while [ "$(basename "$PROJECT_DIR")" != ".opencode" ]; do
    PROJECT_DIR="$(dirname "$PROJECT_DIR")"
done
PROJECT_DIR="$(dirname "$PROJECT_DIR")"
TMP_DIR="$PROJECT_DIR/tmp"

# SC19/SC20: Harness test-env constants for the GB_* suite. These are the harness's
# own constant values — never inherited from the parent shell. When BEHAVIOR_NEEDS_REMOTE=1
# provisions a test GitBucket, __ensure_gitbucket() in helpers.sh exports the provisioned
# instance's values (GB_HOST, GITBUCKET_PORT, GB_REPO, GB_PROTOCOL, GB_TOKEN) into the
# harness process before this wrapper runs; those override the constants.
GB_HOST_CONSTANT="http://localhost:18080"
GB_REPO_CONSTANT="root/test-repo"
GB_PROTOCOL_CONSTANT="http"
GITBUCKET_PORT_CONSTANT="18080"

# Prepend .tools/opencode/ to PATH so the standalone binary is found before /snap/bin/opencode.
# The snap binary hardcodes SNAP_USER_DATA=~/snap/opencode/ and ignores XDG env vars,
# making it impossible to isolate test runs from production state.
if [ -x "$PROJECT_DIR/.tools/opencode/opencode" ]; then
    export PATH="$PROJECT_DIR/.tools/opencode:$PATH"
fi

# OPENCODE_CMD is bare "opencode" — env -i PATH resolution finds $TEST_HOME/bin/opencode
OPENCODE_CMD=("opencode")

usage() {
    echo "Usage: bash .opencode/tests-v2/with-test-home [--setup|--keep|--clean|--clean-all] [command...]" >&2
    echo "" >&2
    echo "  --setup           Create env, run smoke tests, print TEST_HOME=<path>" >&2
    echo "  --keep            Preserve test home after execution (default)" >&2
    echo "  --clean           Remove the most recent test home directory" >&2
    echo "  --clean-all       Remove ALL test home directories under tmp/" >&2
    exit 2
}

do_clean() {
    local latest
    latest="$(find "$TMP_DIR" -maxdepth 1 -mindepth 1 -type d -name 'test-home-*' 2>/dev/null | sort | tail -1)"
    if [ -z "$latest" ]; then
        echo "No test home directories found to clean." >&2
        return 0
    fi
    echo "Removing: $latest" >&2
    rm -rf "$latest"
    echo "Clean removed: $(basename "$latest")" >&2
    return 0
}

do_clean_all() {
    # SC-7: Kill GitBucket process if running
    local gb_pid_file="$PROJECT_DIR/tmp/.gitbucket.pid"
    if [ -f "$gb_pid_file" ]; then
        local gb_pid
        gb_pid=$(cat "$gb_pid_file" 2>/dev/null || true)
        if [ -n "$gb_pid" ] && kill -0 "$gb_pid" 2>/dev/null; then
            echo "Killing GitBucket (PID $gb_pid)..." >&2
            kill "$gb_pid" 2>/dev/null || true
            sleep 1
            kill -0 "$gb_pid" 2>/dev/null && kill -9 "$gb_pid" 2>/dev/null || true
        fi
        rm -f "$gb_pid_file"
    fi
    rm -f "$PROJECT_DIR/tmp/.gitbucket.port"
    rm -rf "$PROJECT_DIR/tmp/gitbucket-data"

    # SC9: remove the multi-submodule fixture clones (test-submodule-1/2) that
    # Phase 3 provisions inside behavior-isolated workdirs. Remove those workdirs
    # too so no provisioned state survives a --clean-all run.
    rm -rf "$PROJECT_DIR/tmp/test-submodule"* "$PROJECT_DIR/tmp/behavior-isolated"*

    local count=0
    while IFS= read -r -d '' dir; do
        echo "Removing: $dir" >&2
        rm -rf "$dir"
        count=$((count + 1))
    done < <(find "$TMP_DIR" -maxdepth 1 -mindepth 1 -type d -name 'test-home-*' -print0 2>/dev/null || true)
    echo "Clean removed $count test home directories." >&2
    return 0
}

seed_model_config() {
    mkdir -p "$TEST_HOME/.config/opencode"

    # Use the default test model only — NEVER call opencode models (reads production DB).
    # Model discovery via Ollama API only returns local models, not cloud models.
    if [ -f "$SCRIPT_DIR/default-model.sh" ]; then
        source "$SCRIPT_DIR/default-model.sh"
    fi
    local default_model="${DEFAULT_TEST_MODEL:-ollama/qwen3.6:35b-256k}"
    local bare="${default_model#ollama/}"

    cat > "$TEST_HOME/.config/opencode/opencode.jsonc" << JSONC
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "$default_model",
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "$bare": {}
      }
    }
  }
}
JSONC
}

# SC20: Seed a pre-fabricated gb config.toml at $TEST_HOME/.config/gb/config.toml so
# gb authenticates deterministically without `gb auth login`. The config carries the
# harness's test-env default_host constant; the host token is present only when a test
# GitBucket was provisioned (BEHAVIOR_NEEDS_REMOTE=1), matching the provisioned test
# instance. Mirrors the fixture format in .opencode/.issues/2059/spec.md.
seed_gb_config() {
    mkdir -p "$TEST_HOME/.config/gb"

    local gb_host="${GB_HOST:-$GB_HOST_CONSTANT}"
    local gb_user="root"
    local gb_token=""
    if [ "${BEHAVIOR_NEEDS_REMOTE:-0}" = "1" ]; then
        gb_token="${GB_TOKEN:-}"
    fi

    cat > "$TEST_HOME/.config/gb/config.toml" << TOML
default_host = "$gb_host"

[hosts."$gb_host"]
user = "$gb_user"
token = "$gb_token"
protocol = "$GB_PROTOCOL_CONSTANT"
TOML
}

do_setup() {
    local timestamp
    timestamp=$(date +%Y%m%d-%H%M%S)
    local test_home="$TMP_DIR/test-home-$timestamp"
    mkdir -p "$test_home"

    # If TEST_WORKDIR is set, use it as the project directory (behavior_run pre-setup).
    # Otherwise create a fresh project directory.
    local test_project
    if [ -n "${TEST_WORKDIR:-}" ] && [ -d "$TEST_WORKDIR" ]; then
        test_project="$TEST_WORKDIR"
        # Move it into the test home so isolation checks pass.
        mv "$test_project" "$test_home/project"
        test_project="$test_home/project"
    else
        test_project="$test_home/project"
        mkdir -p "$test_project"
        git init -q "$test_project"
        git -C "$test_project" config user.email "test@test.dev"
        git -C "$test_project" config user.name "Test"

        local submodule_remote_url
        if [ -f "$PROJECT_DIR/.gitmodules" ]; then
            submodule_remote_url=$(git -C "$PROJECT_DIR" config --get submodule..opencode.url 2>/dev/null || true)
        fi
        if [ -z "$submodule_remote_url" ]; then
            submodule_remote_url="https://github.com/michael-conrad/.opencode.git"
        fi
        submodule_remote_url=$(echo "$submodule_remote_url" | sed 's|^git@github.com:|https://github.com/|' | sed 's|\.git$||')

        git clone -q "$submodule_remote_url" "$test_project/.opencode" 2>/dev/null || {
            echo "HARNESS_FAILURE: git clone failed for .opencode from $submodule_remote_url" >&2
            exit 1
        }

        # Checkout the same commit as the local .opencode submodule to pick up feature branch changes.
        LOCAL_SUBMODULE_COMMIT=$(git -C "$PROJECT_DIR/.opencode" rev-parse HEAD 2>/dev/null || true)
        if [ -n "$LOCAL_SUBMODULE_COMMIT" ]; then
            git -C "$test_project/.opencode" checkout -q "$LOCAL_SUBMODULE_COMMIT" 2>/dev/null || {
                echo "WARNING: could not checkout local submodule commit $LOCAL_SUBMODULE_COMMIT — using remote default branch" >&2
            }
        fi

        git -C "$test_project" add -A 2>/dev/null || true
        git -C "$test_project" commit -q --allow-empty -m "init" 2>/dev/null || true
    fi

    export TEST_HOME="$test_home"
    export TEST_PROJECT="$test_project"

    seed_model_config
    seed_gb_config

    # Warmup: run inside isolated subshell to verify setup without polluting production DB.
    (
        cd "$test_project"
        export XDG_CONFIG_HOME="$test_home/.config"
        export XDG_CACHE_HOME="$test_home/.cache"
        export XDG_RUNTIME_DIR="$test_home/.runtime"
        export XDG_DATA_HOME="$test_home/.local/share"
        export XDG_STATE_HOME="$test_home/.local/state"
        export SNAP_USER_DATA="$test_home/snap/opencode"
        export SNAP_USER_COMMON="$test_home/snap/opencode"
        export USER="opencode-test-user"
        export GIT_CONFIG_NOSYSTEM=1
        export UV_CACHE_DIR="$test_home/.cache/uv"
        export UV_PYTHON_INSTALL_DIR="$test_home/.cache/uv/python"
        export UV_TOOL_DIR="$test_home/.local/share/uv/tools"

        local smoke_output
        smoke_output=$("${OPENCODE_CMD[@]}" models 2>&1 || true)
        if ! echo "$smoke_output" | grep -q '^ollama/'; then
            echo "HARNESS_FAILURE: warmup failed — 'opencode models' returned no models" >&2
            echo "  Output: $smoke_output" >&2
            exit 1
        fi

        local default_model
        if [ -f "$SCRIPT_DIR/default-model.sh" ]; then
            source "$SCRIPT_DIR/default-model.sh"
            default_model="$DEFAULT_TEST_MODEL"
        fi
        if [ -z "${default_model:-}" ]; then
            default_model="ollama/qwen3.6:35b-256k"
        fi
        local hello_output
        hello_output=$("${OPENCODE_CMD[@]}" run "hello world" --model "$default_model" 2>&1 || true)
        if [ -z "$hello_output" ] || echo "$hello_output" | grep -qi 'error\|timeout\|unavailable\|retired\|Gone:'; then
            echo "HARNESS_FAILURE: warmup failed — 'opencode run \"hello world\"' did not produce output" >&2
            echo "  Model: $default_model" >&2
            echo "  Output: $hello_output" >&2
            exit 1
        fi
    ) || exit $?

    # Isolation verification: confirm test home only has opencode files and production DB is untouched.
    local prod_db="$HOME/.local/share/opencode/opencode.db"
    local prod_db_before=""
    if [ -f "$prod_db" ]; then
        prod_db_before=$(sha256sum "$prod_db" 2>/dev/null | cut -d' ' -f1)
    fi

    local test_db="$test_home/.local/share/opencode/opencode.db"
    local test_config="$test_home/.config/opencode/opencode.jsonc"
    local test_logs="$test_home/.local/share/opencode/logs"

    if [ -f "$test_db" ]; then
        echo "  [isolation] test DB exists at $test_db"
    fi
    if [ -f "$test_config" ]; then
        echo "  [isolation] test config exists at $test_config"
    fi

    # Verify no production files leaked into test home.
    local leak_found=0
    while IFS= read -r -d '' f; do
        local rel="${f#$test_home/}"
        case "$rel" in
            .config|.config/opencode|.config/opencode/*|.config/gb|.config/gb/*|.local|.local/share|.local/share/opencode|.local/share/opencode/*|.local/share/uv|.local/share/uv/*|.local/share/fastmcp|.local/share/fastmcp/*|.local/state|.local/state/opencode|.local/state/opencode/*|.cache|.cache/opencode|.cache/opencode/*|.cache/uv|.cache/uv/*|.runtime|.runtime/*|snap|snap/opencode|snap/opencode/*|project|project/*|.git|.git/*)
                ;;
            .gitignore|.gitattributes)
                ;;
            *)
                echo "  [isolation] WARNING: unexpected file in test home: $rel" >&2
                leak_found=1
                ;;
        esac
    done < <(find "$test_home" -mindepth 1 -not -path '*/project/.opencode/*' -not -path '*/.git/objects/*' -not -path '*/.git/refs/*' -print0 2>/dev/null || true)

    if [ "$leak_found" -eq 1 ]; then
        echo "  [isolation] FAIL: test home contains unexpected files" >&2
        exit 1
    fi

    # Verify production DB was not modified by the test setup.
    if [ -n "$prod_db_before" ]; then
        local prod_db_after
        prod_db_after=$(sha256sum "$prod_db" 2>/dev/null | cut -d' ' -f1)
        if [ "$prod_db_before" != "$prod_db_after" ]; then
            echo "  [isolation] FAIL: production DB was modified during test setup!" >&2
            exit 1
        fi
        echo "  [isolation] PASS: production DB unchanged (sha256 match)"
    else
        echo "  [isolation] PASS: no production DB found (local-only environment)"
    fi

    echo "TEST_HOME=$test_home" >&2
    echo "TEST_PROJECT=$test_project"
}

# Sourcing guard
if [ "${BASH_SOURCE[0]}" != "${0}" ]; then
    return 0
fi

MODE="${1:-}"
case "$MODE" in
    --setup)
        do_setup
        exit 0
        ;;
    --clean)
        do_clean
        exit 0
        ;;
    --clean-all)
        do_clean_all
        exit 0
        ;;
    --keep)
        KEEP_TEST_HOME=1
        shift
        ;;
    --help|-h)
        usage
        exit 0
        ;;
    *)
        # Default: preserve test home
        KEEP_TEST_HOME=1
        ;;
esac

# Run command inside isolated env
if [ $# -eq 0 ]; then
    usage
    exit 1
fi

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
TEST_HOME="$TMP_DIR/test-home-$TIMESTAMP"
mkdir -p "$TEST_HOME"

# If TEST_WORKDIR is set, use it as the project directory (behavior_run pre-setup).
if [ -n "${TEST_WORKDIR:-}" ] && [ -d "$TEST_WORKDIR" ]; then
    mv "$TEST_WORKDIR" "$TEST_HOME/project"
    TEST_PROJECT="$TEST_HOME/project"
else
    TEST_PROJECT="$TEST_HOME/project"
    mkdir -p "$TEST_PROJECT"
    git init -q "$TEST_PROJECT"
    git -C "$TEST_PROJECT" config user.email "test@test.dev"
    git -C "$TEST_PROJECT" config user.name "Test"

    SUBMODULE_REMOTE_URL="https://github.com/michael-conrad/.opencode.git"
    if [ -f "$PROJECT_DIR/.gitmodules" ]; then
        SUBMODULE_REMOTE_URL=$(git -C "$PROJECT_DIR" config --get submodule..opencode.url 2>/dev/null || echo "https://github.com/michael-conrad/.opencode.git")
    fi
    SUBMODULE_REMOTE_URL=$(echo "$SUBMODULE_REMOTE_URL" | sed 's|^git@github.com:|https://github.com/|' | sed 's|\.git$||')

    git clone -q "$SUBMODULE_REMOTE_URL" "$TEST_PROJECT/.opencode" 2>/dev/null || {
        echo "HARNESS_FAILURE: git clone failed for .opencode from $SUBMODULE_REMOTE_URL" >&2
        exit 1
    }

    # Checkout the same commit as the local .opencode submodule to pick up feature branch changes.
    LOCAL_SUBMODULE_COMMIT=$(git -C "$PROJECT_DIR/.opencode" rev-parse HEAD 2>/dev/null || true)
    if [ -n "$LOCAL_SUBMODULE_COMMIT" ]; then
        git -C "$TEST_PROJECT/.opencode" checkout -q "$LOCAL_SUBMODULE_COMMIT" 2>/dev/null || {
            echo "WARNING: could not checkout local submodule commit $LOCAL_SUBMODULE_COMMIT — using remote default branch" >&2
        }
    fi

    git -C "$TEST_PROJECT" add -A 2>/dev/null || true
    git -C "$TEST_PROJECT" commit -q --allow-empty -m "init" 2>/dev/null || true
fi

seed_model_config
seed_gb_config

# Copy standalone binary to $TEST_HOME/bin so env -i PATH resolution finds it.
STANDALONE_BINARY="$PROJECT_DIR/.tools/opencode/opencode"
if [ -x "$STANDALONE_BINARY" ]; then
    mkdir -p "$TEST_HOME/bin"
    cp "$STANDALONE_BINARY" "$TEST_HOME/bin/opencode"
else
    echo "FATAL: standalone binary not found at $STANDALONE_BINARY" >&2
    exit 1
fi

# Copy uv and uvx into test home bin for Python-based plugin operations.
UV_DIR="$PROJECT_DIR/.tools/uv"
if [ -x "$UV_DIR/uv" ]; then
    mkdir -p "$TEST_HOME/bin"
    cp "$UV_DIR/uv" "$TEST_HOME/bin/uv"
    cp "$UV_DIR/uvx" "$TEST_HOME/bin/uvx"
fi

# Write set-env.sh into test home for debugging env -i setup.
cat > "$TEST_HOME/set-env.sh" << SETENV
#!/bin/bash
# Source this file to replicate the test environment.
# Generated by with-test-home.
export HOME="$TEST_HOME"
export PATH="$TEST_HOME/bin:$PATH"
export XDG_CONFIG_HOME="$TEST_HOME/.config"
export XDG_CACHE_HOME="$TEST_HOME/.cache"
export XDG_RUNTIME_DIR="$TEST_HOME/.runtime"
export XDG_DATA_HOME="$TEST_HOME/.local/share"
export XDG_STATE_HOME="$TEST_HOME/.local/state"
export SNAP_USER_DATA="$TEST_HOME/snap/opencode"
export SNAP_USER_COMMON="$TEST_HOME/snap/opencode"
export USER="opencode-test-user"
export GIT_CONFIG_NOSYSTEM=1
export SHELL="$SHELL"
export LOGNAME="$LOGNAME"
export LANG="$LANG"
export TERM="$TERM"
export BEHAVIOR_NEEDS_MULTI_SUBMODULES="${BEHAVIOR_NEEDS_MULTI_SUBMODULES:-}"
export BEHAVIOR_NEEDS_REMOTE="${BEHAVIOR_NEEDS_REMOTE:-}"
export BEHAVIOR_SET_BARE_REMOTE="${BEHAVIOR_SET_BARE_REMOTE:-}"
SETENV

# SC17/SC19: Record the test-env GB_* entries in set-env.sh. The test-env constants
# (GB_HOST, GB_REPO, GB_PROTOCOL, GITBUCKET_PORT) are ALWAYS written to the harness's
# constant values; GB_TOKEN (the credential secret) is scoped to the provisioned test
# instance only, written when BEHAVIOR_NEEDS_REMOTE=1. Parent/production GB_* are never
# written to set-env.sh (no parent passthrough).
# The heredoc uses <<- with tab indentation so the exported lines do not begin at
# column 0 in this source file (SC17b: no parent-sourced `export GB_` passthrough).
cat >> "$TEST_HOME/set-env.sh" <<- SETENV_GB
	export GB_HOST="${GB_HOST:-$GB_HOST_CONSTANT}"
	export GITBUCKET_PORT="${GITBUCKET_PORT:-$GITBUCKET_PORT_CONSTANT}"
	export GB_REPO="${GB_REPO:-$GB_REPO_CONSTANT}"
	export GB_PROTOCOL="${GB_PROTOCOL:-$GB_PROTOCOL_CONSTANT}"
SETENV_GB
if [ "${BEHAVIOR_NEEDS_REMOTE:-0}" = "1" ]; then
	cat >> "$TEST_HOME/set-env.sh" <<- SETENV_GB_TOKEN
		export GB_TOKEN="${GB_TOKEN:-}"
	SETENV_GB_TOKEN
fi
chmod +x "$TEST_HOME/set-env.sh"

# Print [test-env] diagnostics before running the command.
# TEST_HOME= on stderr is machine-parseable for __export_sqlite_to_yaml in helpers.sh
echo "TEST_HOME=$TEST_HOME" >&2
echo "[test-env] HOME=$TEST_HOME"
echo "[test-env] PATH=$TEST_HOME/bin:$PATH"
echo "[test-env] USER=opencode-test-user"
echo "[test-env] XDG_DATA_HOME=$TEST_HOME/.local/share"
echo "[test-env] XDG_CONFIG_HOME=$TEST_HOME/.config"
echo "[test-env] XDG_STATE_HOME=$TEST_HOME/.local/state"
echo "[test-env] XDG_CACHE_HOME=$TEST_HOME/.cache"
echo "[test-env] SNAP_USER_DATA=$TEST_HOME/snap/opencode"
echo "[test-env] opencode=$TEST_HOME/bin/opencode"

# SC13/SC16/SC17(a)/SC19: Scope GitBucket values into the isolated env.
#
# The test-env constants (GB_HOST, GB_REPO, GB_PROTOCOL, GITBUCKET_PORT) are ALWAYS
# added to GB_ENV_ARGS (unconditionally), set to the harness's constant values
# (overridden by the harness process's provisioned instance values when
# __ensure_gitbucket() exports them under BEHAVIOR_NEEDS_REMOTE=1). GB_TOKEN (the
# credential secret) is added ONLY under the BEHAVIOR_NEEDS_REMOTE=1 guard, scoped to
# the provisioned test instance.
#
# Guard: parent/production GB_* never leak into the isolated env. The constants use
# the harness constant fallback (not parent values); GB_TOKEN is absent when GitBucket
# is not provisioned (SC17/SC19).
GB_ENV_ARGS=(GB_HOST="${GB_HOST:-$GB_HOST_CONSTANT}" GITBUCKET_PORT="${GITBUCKET_PORT:-$GITBUCKET_PORT_CONSTANT}" GB_REPO="${GB_REPO:-$GB_REPO_CONSTANT}" GB_PROTOCOL="${GB_PROTOCOL:-$GB_PROTOCOL_CONSTANT}")
if [ "${BEHAVIOR_NEEDS_REMOTE:-0}" = "1" ]; then
    GB_ENV_ARGS+=(GB_TOKEN="${GB_TOKEN:-}")
fi

# Isolate XDG state AND snap data to test home using env -i with explicit allowlist.
# FORBIDDEN: /snap/bin/opencode and snap run hardcode SNAP_USER_DATA=~/snap/opencode/
# Override SNAP_USER_DATA to redirect the SQLite DB to the test home instead of production.
RC=0
env -i -C "$TEST_PROJECT" \
    HOME="$TEST_HOME" \
    PATH="$TEST_HOME/bin:$PATH" \
    XDG_CONFIG_HOME="$TEST_HOME/.config" \
    XDG_CACHE_HOME="$TEST_HOME/.cache" \
    XDG_RUNTIME_DIR="$TEST_HOME/.runtime" \
    XDG_DATA_HOME="$TEST_HOME/.local/share" \
    XDG_STATE_HOME="$TEST_HOME/.local/state" \
    SNAP_USER_DATA="$TEST_HOME/snap/opencode" \
    SNAP_USER_COMMON="$TEST_HOME/snap/opencode" \
    USER="opencode-test-user" \
    GIT_CONFIG_NOSYSTEM=1 \
    SHELL="$SHELL" \
    LOGNAME="opencode-test-user" \
    LANG="$LANG" \
    TERM="$TERM" \
    BEHAVIOR_NEEDS_MULTI_SUBMODULES="${BEHAVIOR_NEEDS_MULTI_SUBMODULES:-}" \
    BEHAVIOR_NEEDS_REMOTE="${BEHAVIOR_NEEDS_REMOTE:-}" \
    BEHAVIOR_SET_BARE_REMOTE="${BEHAVIOR_SET_BARE_REMOTE:-}" \
    "${GB_ENV_ARGS[@]}" \
    "$@" 2>&1 || RC=$?

if [ "${KEEP_TEST_HOME:-0}" != "1" ]; then
    rm -rf "$TEST_HOME"
fi

exit $RC
