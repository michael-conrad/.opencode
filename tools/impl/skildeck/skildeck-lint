"""
DESCRIPTION: Lint skill and guideline files for consistency, completeness, and gate compliance.
Usage: ./.opencode/tools/skildeck lint [--skill NAME] [--gate NAME] [--scope SCOPE] [--json]
"""

import json
import os as _os
import subprocess
import sys
import types
from dataclasses import dataclass, asdict
from pathlib import Path

# Find skills directory without git assumptions
IMPL_DIR = Path(__file__).resolve().parent
SKILLS_DIR = None
for parent in [IMPL_DIR] + list(IMPL_DIR.parents):
    candidate = parent / "skills"
    if candidate.exists() and candidate.is_dir():
        SKILLS_DIR = candidate
        break

if SKILLS_DIR is None:
    if _os.environ.get("SKILDECK_SKILLS_DIR"):
        SKILLS_DIR = Path(_os.environ["SKILDECK_SKILLS_DIR"])
    else:
        raise RuntimeError(f"Cannot find skills/ directory. Searched up from {IMPL_DIR}. Set SKILDECK_SKILLS_DIR env var to override.")

DEFAULT_SCAN_DIR = SKILLS_DIR

FENCE_PATTERN = __import__("re").compile(
    r"```yaml\+symbolic\n(.*?)```", __import__("re").DOTALL
)

@dataclass
class LintFinding:
    severity: str
    category: str
    source: str
    rule_id: str = ""
    message: str = ""

    def to_dict(self) -> dict:
        return asdict(self)

def _load_sym_extract():
    source = (IMPL_DIR.parent / "sym-extract").read_text()
    mod = types.ModuleType("sym_extract")
    mod.__file__ = str(IMPL_DIR.parent / "sym-extract")
    sys.modules["sym_extract"] = mod
    exec(compile(source, str(IMPL_DIR.parent / "sym-extract"), "exec"), mod.__dict__)
    return mod

def _extract_source_label(filepath: Path, scan_dir: Path) -> str:
    try:
        return str(filepath.relative_to(scan_dir))
    except ValueError:
        return str(filepath)

def _extract_yaml_frontmatter(text: str) -> dict | None:
    """Extract YAML frontmatter if present (between --- delimiters at start)."""
    import yaml
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return None
    end_idx = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            end_idx = i
            break
    if end_idx is None:
        return None
    try:
        return yaml.safe_load("\n".join(lines[1:end_idx]))
    except yaml.YAMLError:
        return None

def lint_skill_frontmatter(base_dir: Path) -> list[LintFinding]:
    """Validate SKILL.md YAML frontmatter against opencode schema."""
    import yaml
    findings: list[LintFinding] = []

    skills_dir = base_dir / "skills"
    if not skills_dir.exists():
        return findings

    recognized_fields = {"name", "description", "license", "compatibility", "metadata", "type"}
    name_re = __import__("re").compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")

    for skill_dir in sorted(skills_dir.iterdir()):
        if not skill_dir.is_dir():
            continue
        skmd = skill_dir / "SKILL.md"
        if not skmd.exists():
            continue

        rel = str(skmd.relative_to(base_dir))
        text = skmd.read_text()
        lines = text.split("\n")

        # Extract YAML frontmatter
        if not lines or lines[0].strip() != "---":
            findings.append(LintFinding(
                severity="error", category="skill-frontmatter",
                source=rel, rule_id="frontmatter-missing",
                message="SKILL.md missing YAML frontmatter (no opening ---)"
            ))
            continue

        end_idx = None
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                end_idx = i
                break
        if end_idx is None:
            findings.append(LintFinding(
                severity="error", category="skill-frontmatter",
                source=rel, rule_id="frontmatter-unclosed",
                message="YAML frontmatter has no closing ---"
            ))
            continue

        fm_text = "\n".join(lines[1:end_idx])
        try:
            fm = yaml.safe_load(fm_text)
        except yaml.YAMLError as e:
            findings.append(LintFinding(
                severity="error", category="skill-frontmatter",
                source=rel, rule_id="frontmatter-parse",
                message=f"YAML frontmatter parse error: {e}"
            ))
            continue

        if not isinstance(fm, dict):
            findings.append(LintFinding(
                severity="error", category="skill-frontmatter",
                source=rel, rule_id="frontmatter-type",
                message="YAML frontmatter is not a dict"
            ))
            continue

        dirname = skill_dir.name

        # name field
        if "name" not in fm:
            findings.append(LintFinding(
                severity="error", category="skill-frontmatter",
                source=rel, rule_id="name-missing",
                message="Required field 'name' is missing"
            ))
        else:
            name_val = str(fm["name"])
            if name_val != dirname:
                findings.append(LintFinding(
                    severity="error", category="skill-frontmatter",
                    source=rel, rule_id="name-directory-mismatch",
                    message=f"name '{name_val}' does not match directory name '{dirname}'"
                ))
            if not name_re.match(name_val):
                findings.append(LintFinding(
                    severity="error", category="skill-frontmatter",
                    source=rel, rule_id="name-format",
                    message=f"name '{name_val}' does not match regex ^[a-z0-9]+(-[a-z0-9]+)*$"
                ))
            if len(name_val) < 1 or len(name_val) > 64:
                findings.append(LintFinding(
                    severity="error", category="skill-frontmatter",
                    source=rel, rule_id="name-length",
                    message=f"name '{name_val}' is {len(name_val)} chars (must be 1-64)"
                ))

        # description field
        if "description" not in fm:
            findings.append(LintFinding(
                severity="error", category="skill-frontmatter",
                source=rel, rule_id="description-missing",
                message="Required field 'description' is missing"
            ))
        else:
            desc_val = str(fm["description"])
            if len(desc_val) < 1 or len(desc_val) > 1024:
                findings.append(LintFinding(
                    severity="error", category="skill-frontmatter",
                    source=rel, rule_id="description-length",
                    message=f"description is {len(desc_val)} chars (must be 1-1024)"
                ))
            # Check description is quoted in raw YAML text
            desc_line = None
            for line in fm_text.split("\n"):
                stripped = line.strip()
                if stripped.startswith("description:"):
                    desc_line = stripped
                    break
            if desc_line:
                val_part = desc_line.split(":", 1)[1].strip()
                if val_part and not (val_part.startswith('"') or val_part.startswith("'")):
                    findings.append(LintFinding(
                        severity="error", category="skill-frontmatter",
                        source=rel, rule_id="description-unquoted",
                        message="description value is not quoted in YAML frontmatter"
                    ))

        # license field (optional, SPDX check)
        if "license" in fm:
            lic_val = str(fm["license"])
            # Basic SPDX check: must be uppercase with hyphens
            spdx_re = __import__("re").compile(r"^[A-Z][A-Za-z0-9\-\.]+$")
            if not spdx_re.match(lic_val):
                findings.append(LintFinding(
                    severity="warning", category="skill-frontmatter",
                    source=rel, rule_id="license-spdx",
                    message=f"license '{lic_val}' does not look like a valid SPDX identifier"
                ))

        # Unknown fields
        for key in fm:
            if key not in recognized_fields:
                findings.append(LintFinding(
                    severity="error", category="skill-frontmatter",
                    source=rel, rule_id="unknown-field",
                    message=f"Unknown frontmatter field '{key}'"
                ))

    return findings


def lint_progressive_disclosure(base_dir: Path) -> list[LintFinding]:
    findings: list[LintFinding] = []

    guidelines_dir = base_dir / "guidelines"
    skills_dir = base_dir / "skills"

    if guidelines_dir.exists():
        guideline_files = sorted(guidelines_dir.glob("*.md"))
        for gf in guideline_files:
            if gf.name == "INDEX.md":
                wc = len(gf.read_text().split())
                if wc > 1500:
                    findings.append(LintFinding(
                        severity="error", category="progressive-disclosure",
                        source=str(gf.relative_to(base_dir)),
                        rule_id="index-word-count", message=f"INDEX.md is {wc} words (limit 1500)"
                    ))
                continue
            text = gf.read_text()
            fm = _extract_yaml_frontmatter(text)
            if fm is None or "trigger_on" not in fm:
                findings.append(LintFinding(
                    severity="error", category="progressive-disclosure",
                    source=str(gf.relative_to(base_dir)),
                    rule_id="guideline-frontmatter", message="missing trigger_on frontmatter"
                ))
            if fm is None or "load_when" not in fm:
                findings.append(LintFinding(
                    severity="error", category="progressive-disclosure",
                    source=str(gf.relative_to(base_dir)),
                    rule_id="guideline-frontmatter", message="missing load_when frontmatter"
                ))

    if skills_dir.exists():
        total_desc_words = 0
        for skill_dir in sorted(skills_dir.iterdir()):
            if not skill_dir.is_dir():
                continue
            skmd = skill_dir / "SKILL.md"
            if not skmd.exists():
                continue
            wc = len(skmd.read_text().split())
            total_desc_words += wc
            if wc > 600:
                findings.append(LintFinding(
                    severity="error", category="progressive-disclosure",
                    source=str(skmd.relative_to(base_dir)),
                    rule_id="skill-word-count", message=f"SKILL.md is {wc} words (limit 600)"
                ))
        if total_desc_words > 1000:
            findings.append(LintFinding(
                severity="error", category="progressive-disclosure",
                source="skills/",
                rule_id="skill-index-size", message=f"Combined SKILL.md descriptions are {total_desc_words} words (limit 1000)"
            ))

    return findings

def lint_all(
    scan_dir: Path,
    skill_filter: str = "",
    gate_filter: str = "",
    scope_filter: str = "",
) -> list[LintFinding]:
    import yaml

    findings: list[LintFinding] = []
    md_files = sorted(scan_dir.rglob("*.md"))

    for md_file in md_files:
        rel = _extract_source_label(md_file, scan_dir)
        if skill_filter and skill_filter.lower() not in rel.lower():
            continue
        if scope_filter and scope_filter.lower() not in rel.lower():
            continue
        try:
            text = md_file.read_text()
        except Exception as e:
            findings.append(
                LintFinding(
                    severity="error",
                    category="io",
                    source=rel,
                    message=f"cannot read: {e}",
                )
            )
            continue

        for match in FENCE_PATTERN.finditer(text):
            yaml_text = match.group(1)
            try:
                data = yaml.safe_load(yaml_text)
            except yaml.YAMLError as e:
                findings.append(
                    LintFinding(
                        severity="error",
                        category="parse",
                        source=rel,
                        message=f"YAML parse error: {e}",
                    )
                )
                continue
            if not isinstance(data, dict):
                findings.append(
                    LintFinding(
                        severity="error",
                        category="structure",
                        source=rel,
                        message=f"expected dict, got {type(data).__name__}",
                    )
                )
                continue

            sv = data.get("schema_version", "")
            if sv not in ("1.0", "2.0"):
                findings.append(
                    LintFinding(
                        severity="error",
                        category="schema",
                        source=rel,
                        message=f"unsupported schema_version: {sv!r}",
                    )
                )
                continue

            for rule_raw in data.get("rules", []):
                if not isinstance(rule_raw, dict):
                    continue
                rid = rule_raw.get("id", "?")
                if gate_filter and gate_filter.lower() not in rid.lower():
                    continue
                if "title" not in rule_raw:
                    findings.append(
                        LintFinding(
                            severity="warning",
                            category="completeness",
                            source=rel,
                            rule_id=rid,
                            message="rule missing 'title'",
                        )
                    )
                if "actions" not in rule_raw or not rule_raw["actions"]:
                    findings.append(
                        LintFinding(
                            severity="warning",
                            category="completeness",
                            source=rel,
                            rule_id=rid,
                            message="rule has empty or missing 'actions'",
                        )
                    )
                if "source" not in rule_raw or not rule_raw["source"]:
                    findings.append(
                        LintFinding(
                            severity="warning",
                            category="traceability",
                            source=rel,
                            rule_id=rid,
                            message="rule missing 'source'",
                        )
                    )

            for gate_raw in data.get("gates", []):
                if not isinstance(gate_raw, dict):
                    continue
                gid = gate_raw.get("id", "?")
                if gate_filter and gate_filter.lower() not in gid.lower():
                    continue
                if "condition" not in gate_raw:
                    findings.append(
                        LintFinding(
                            severity="error",
                            category="completeness",
                            source=rel,
                            rule_id=gid,
                            message="gate missing 'condition'",
                        )
                    )

            for ea_raw in data.get("evidence_artifacts", []):
                if not isinstance(ea_raw, dict):
                    continue
                name = ea_raw.get("name", "?")
                if "verification" not in ea_raw or not ea_raw["verification"]:
                    findings.append(
                        LintFinding(
                            severity="warning",
                            category="completeness",
                            source=rel,
                            rule_id=name,
                            message="evidence_artifact missing 'verification'",
                        )
                    )

            for sm_raw in data.get("state_machines", []):
                if not isinstance(sm_raw, dict):
                    continue
                sm_id = sm_raw.get("id", "?")
                if gate_filter and gate_filter.lower() not in sm_id.lower():
                    continue
                if "start_state" not in sm_raw:
                    findings.append(
                        LintFinding(
                            severity="warning",
                            category="completeness",
                            source=rel,
                            rule_id=sm_id,
                            message="state_machine missing 'start_state'",
                        )
                    )
                states = sm_raw.get("states", [])
                transitions = sm_raw.get("transitions", [])
                for t in transitions:
                    if isinstance(t, dict):
                        if t.get("from") not in states:
                            findings.append(
                                LintFinding(
                                    severity="warning",
                                    category="consistency",
                                    source=rel,
                                    rule_id=sm_id,
                                    message=f"transition from={t.get('from')} not in states list",
                                )
                            )

    return findings

def _load_skilldeck_ignore(skill_dir: Path) -> set[str]:
    """Load .skilldeck-ignore patterns from a skill directory."""
    ignore_file = skill_dir / ".skilldeck-ignore"
    if not ignore_file.exists():
        return set()
    patterns: set[str] = set()
    for line in ignore_file.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            patterns.add(line)
    return patterns


def _is_ignored(path: Path, ignore_patterns: set[str], base_dir: Path) -> bool:
    """Check if a path matches any .skilldeck-ignore pattern."""
    try:
        rel = str(path.relative_to(base_dir))
    except ValueError:
        return False
    for pattern in ignore_patterns:
        if pattern in rel:
            return True
    return False


def lint_skill_deck_completeness(base_dir: Path) -> list[LintFinding]:
    """Validate skill deck completeness: every skill dir has SKILL.md, TDT refs resolve, tasks/ dirs have SKILL.md."""
    import yaml
    findings: list[LintFinding] = []

    skills_dir = base_dir / "skills"
    if not skills_dir.exists():
        return findings

    # Load global .skilldeck-ignore from skills/reference/
    global_ignore = _load_skilldeck_ignore(skills_dir / "reference")

    for skill_dir in sorted(skills_dir.iterdir()):
        if not skill_dir.is_dir():
            continue
        dir_ignore = _load_skilldeck_ignore(skill_dir)
        all_ignore = global_ignore | dir_ignore

        rel = str(skill_dir.relative_to(base_dir))

        if _is_ignored(skill_dir, all_ignore, base_dir):
            continue

        # Check 1: Every skill directory has a SKILL.md
        skmd = skill_dir / "SKILL.md"
        if not skmd.exists():
            findings.append(LintFinding(
                severity="error", category="skill-deck-completeness",
                source=rel, rule_id="MISSING_SKILL_MD",
                message=f"Skill directory '{skill_dir.name}' has no SKILL.md"
            ))
            continue  # Can't check TDT without SKILL.md

        # Check 2: Every tasks/ directory has a SKILL.md
        tasks_dir = skill_dir / "tasks"
        if tasks_dir.exists() and tasks_dir.is_dir():
            tasks_skmd = tasks_dir / "SKILL.md"
            if not tasks_skmd.exists():
                if not _is_ignored(tasks_dir, all_ignore, base_dir):
                    findings.append(LintFinding(
                        severity="error", category="skill-deck-completeness",
                        source=f"{rel}/tasks", rule_id="MISSING_SKILL_MD_FOR_TASKS_DIR",
                        message=f"tasks/ directory in '{skill_dir.name}' has no SKILL.md"
                    ))

        # Check 3: TDT references resolve to existent task files
        text = skmd.read_text()
        lines = text.split("\n")
        # Find Trigger Dispatch Table section
        in_tdt = False
        for line in lines:
            stripped = line.strip()
            if stripped.startswith("## Trigger Dispatch Table") or stripped.startswith("| User says / Context"):
                in_tdt = True
                continue
            if in_tdt and stripped.startswith("## "):
                in_tdt = False
                continue
            if not in_tdt:
                continue
            # Look for task references in table rows
            # Pattern: | `task-name` | or | task-name |
            if "|" not in stripped:
                continue
            cells = [c.strip() for c in stripped.split("|")]
            for cell in cells:
                cell = cell.strip("`")
                # Check if this looks like a task reference
                if cell.startswith("task(") or cell.startswith("`task("):
                    continue
                # Check for task file references like `tasks/name.md`
                if cell.startswith("tasks/") and cell.endswith(".md"):
                    task_path = skill_dir / cell
                    if not task_path.exists():
                        findings.append(LintFinding(
                            severity="error", category="skill-deck-completeness",
                            source=f"{rel}/SKILL.md", rule_id="MISSING_TASK_FILE",
                            message=f"TDT references '{cell}' but file does not exist at {task_path.relative_to(base_dir)}"
                        ))

    return findings


def lint_skill_workflows_prompts(base_dir: Path) -> list[LintFinding]:
    """Validate that Workflows-section '- Prompt:' lines conform to the canonical task() dispatch prompt format.

    Canonical format:
      Dispatch a sub-agent with the prompt "Follow the instructions in [<skill>/tasks/<task>.md](.opencode/skills/<skill>/tasks/<task>.md). {context data}"
    """
    import re
    findings: list[LintFinding] = []

    skills_dir = base_dir / "skills"
    if not skills_dir.exists():
        return findings

    global_ignore = _load_skilldeck_ignore(skills_dir / "reference")

    canonical_prefix = 'Dispatch a sub-agent with the prompt "Follow the instructions in ['
    link_re = re.compile(r"\[([^\]]+)\]\(([^)]+)\)")

    for skill_dir in sorted(skills_dir.iterdir()):
        if not skill_dir.is_dir():
            continue
        dir_ignore = _load_skilldeck_ignore(skill_dir)
        all_ignore = global_ignore | dir_ignore
        if _is_ignored(skill_dir, all_ignore, base_dir):
            continue

        skmd = skill_dir / "SKILL.md"
        if not skmd.exists():
            continue
        rel = str(skmd.relative_to(base_dir))

        text = skmd.read_text()
        lines = text.split("\n")

        in_workflows = False
        for line in lines:
            stripped = line.strip()
            if stripped.startswith("## Workflows"):
                in_workflows = True
                continue
            if in_workflows and stripped.startswith("## "):
                in_workflows = False
                continue
            if not in_workflows:
                continue
            if not stripped.startswith("- Prompt:"):
                continue

            raw = stripped[len("- Prompt:"):].strip()
            if raw.startswith("`") and raw.endswith("`"):
                raw = raw[1:-1]
            if len(raw) >= 2 and raw.startswith('"') and raw.endswith('"'):
                raw = raw[1:-1]
            if len(raw) >= 2 and raw.startswith("'") and raw.endswith("'"):
                raw = raw[1:-1]
            prompt = raw.strip()
            if not prompt:
                continue

            # Rule 1: old-format prompt lines
            if prompt.startswith("Read ") and "follow its instructions" in prompt:
                findings.append(LintFinding(
                    severity="error", category="skill-workflows",
                    source=rel, rule_id="non-canonical-prompt",
                    message=f"Non-canonical (old) prompt format: '{prompt}'"
                ))
                continue
            if prompt.startswith("Dispatch a sub-agent to read") and "follow the instructions" in prompt:
                findings.append(LintFinding(
                    severity="error", category="skill-workflows",
                    source=rel, rule_id="non-canonical-prompt",
                    message=f"Non-canonical (old) prompt format: '{prompt}'"
                ))
                continue

            # Rule 2: must start with the canonical dispatch prefix
            if not prompt.startswith(canonical_prefix):
                findings.append(LintFinding(
                    severity="error", category="skill-workflows",
                    source=rel, rule_id="non-canonical-prompt",
                    message=f"Prompt does not start with canonical prefix: '{prompt}'"
                ))
                continue

            # Rule 3: markdown link target must resolve to a valid task file
            m = link_re.search(prompt)
            if not m:
                findings.append(LintFinding(
                    severity="error", category="skill-workflows",
                    source=rel, rule_id="non-canonical-prompt",
                    message=f"Prompt has no markdown link to a task file: '{prompt}'"
                ))
                continue
            target = m.group(2)
            task_path = (base_dir.parent / target).resolve()
            if not task_path.exists():
                findings.append(LintFinding(
                    severity="error", category="skill-workflows",
                    source=rel, rule_id="non-canonical-prompt",
                    message=f"Prompt link target does not exist: '{target}'"
                ))

    return findings


def lint_skill_card_format_rules(base_dir: Path) -> list[LintFinding]:
    """Enforce the #2254 skill-card format rules (SC-28).

    Rules:
      R1 numbered-checkbox workflow format — workflow steps MUST use `- [ ] N.`
         markers, not plain numbered lists (`N.` / `N.`).
      R2 execution-mode sub-bullet — every workflow step MUST carry an
         `Execution mode:` sub-bullet (inline or sub-agent dispatch).
      R3 task-card clean-room unit — task-card Procedure MUST NOT contain
         internal sub-agent dispatch (`task(...)` / `skill({`) calls.
      R4 dispatch-contract completeness — every workflow Context sub-bullet MUST
         supply every parameter named in the dispatched task card's Entry
         Criteria.
      R5 markdown link correctness — every markdown link in a workflow step's
         prompt MUST resolve to an existing file.
    """
    import re
    findings: list[LintFinding] = []

    skills_dir = base_dir / "skills"
    if not skills_dir.exists():
        return findings

    global_ignore = _load_skilldeck_ignore(skills_dir / "reference")

    for skill_dir in sorted(skills_dir.iterdir()):
        if not skill_dir.is_dir():
            continue
        dir_ignore = _load_skilldeck_ignore(skill_dir)
        all_ignore = global_ignore | dir_ignore
        if _is_ignored(skill_dir, all_ignore, base_dir):
            continue

        skmd = skill_dir / "SKILL.md"
        if not skmd.exists():
            continue
        rel = str(skmd.relative_to(base_dir))
        text = skmd.read_text()
        lines = text.split("\n")

        # --- R1 / R2 / R5: Workflows section checks -----------------------
        in_workflows = False
        current_step_num = None
        step_has_execution_mode = False
        for line in lines:
            stripped = line.strip()
            if stripped.startswith("## Workflows"):
                in_workflows = True
                continue
            if in_workflows and stripped.startswith("## "):
                in_workflows = False
                continue
            if not in_workflows:
                continue

            # R2: detect end of a workflow step — flush pending step state when a
            # new step or non-sub-bullet line begins.
            checkbox_step = re.match(r"^- \[ \] ([0-9]+(?:\.[0-9]+)?)\.", stripped)
            # A plain numbered list is only a workflow dispatch step if it looks
            # like a dispatch (contains 'Dispatch', 'task(', or a markdown link).
            # Plain prose numbered lists (principles, remediation steps) are NOT
            # workflow steps and must not be flagged.
            plain_step = re.match(r"^([0-9]+)\.\s+\*\*", stripped)
            is_dispatch_like = any(k in stripped for k in ("Dispatch", "task(", "skill(", "](.", "]./"))
            if checkbox_step:
                if current_step_num is not None and not step_has_execution_mode:
                    findings.append(LintFinding(
                        severity="error", category="skill-format",
                        source=rel, rule_id="execution-mode-missing",
                        message=f"Workflow step {current_step_num} has no 'Execution mode:' sub-bullet"
                    ))
                current_step_num = checkbox_step.group(1)
                step_has_execution_mode = False
            elif plain_step and is_dispatch_like:
                # R1: plain numbered dispatch list is forbidden in Workflows.
                findings.append(LintFinding(
                    severity="error", category="skill-format",
                    source=rel, rule_id="workflow-not-checkbox",
                    message=f"Workflow step '{plain_step.group(1)}.' uses a plain numbered list; must use '- [ ] {plain_step.group(1)}.'"
                ))
            elif stripped.startswith("- ") and "Execution mode:" in stripped:
                step_has_execution_mode = True
            # R5: markdown dispatch links must resolve. Only check lines that are
            # dispatch step headers or dispatch sub-bullets (carry 'Dispatch' or
            # 'prompt:'). Prose cross-reference links (e.g., "Read [audit
            # skill](skills/audit/SKILL.md)" in critical-rules sections) are not
            # dispatch targets and must not be flagged. Template placeholders
            # (<...>) and context placeholders ({...}) are not literal paths.
            if ("Dispatch" in stripped or "prompt:" in stripped.lower()) \
                    and "<" not in stripped and "{" not in stripped:
                link_re = re.compile(r"\]\(([^)]+)\)")
                for m in link_re.finditer(stripped):
                    target = m.group(1)
                    if target.startswith("http://") or target.startswith("https://"):
                        continue
                    if not target.endswith(".md"):
                        continue
                    link_path = (base_dir.parent / target).resolve()
                    if not link_path.exists():
                        findings.append(LintFinding(
                            severity="error", category="skill-format",
                            source=rel, rule_id="markdown-link-broken",
                            message=f"Workflow markdown link target does not exist: '{target}'"
                        ))
        if current_step_num is not None and not step_has_execution_mode:
            findings.append(LintFinding(
                severity="error", category="skill-format",
                source=rel, rule_id="execution-mode-missing",
                message=f"Workflow step {current_step_num} has no 'Execution mode:' sub-bullet"
            ))

        # --- R3: task-card clean-room unit --------------------------------
        tasks_dir = skill_dir / "tasks"
        if tasks_dir.exists() and tasks_dir.is_dir():
            for task_file in sorted(tasks_dir.glob("*.md")):
                ttext = task_file.read_text()
                # Find the Procedure section.
                proc_match = re.search(r"^## Procedure\s*$(.*?)(?=^## |\Z)", ttext, re.MULTILINE | re.DOTALL)
                proc_body = proc_match.group(1) if proc_match else ""
                # Match actual invocation patterns only, not prose mentions:
                #   `task(..., prompt: ...)`, `task({name: ...})`, `task(subagent_type=...)`
                #   `skill({name: ...})`, `skill(name=...)`
                # Exclude negative/prohibition mentions like "Do NOT call task()"
                # and quoted strings like "'Load via skill() when'".
                internal_dispatch_re = re.compile(r"\b(task\(|skill\(\s*\{)")
                for proc_line in proc_body.splitlines():
                    if "NOT call" in proc_line or "not call" in proc_line:
                        continue
                    if "'" in proc_line:
                        continue
                    if internal_dispatch_re.search(proc_line):
                        findings.append(LintFinding(
                            severity="error", category="skill-format",
                            source=f"{rel}/tasks/{task_file.name}", rule_id="task-card-internal-dispatch",
                            message="Task-card Procedure contains an internal sub-agent dispatch (task()/skill({) — violates the clean-room unit"
                        ))
                        break

        # --- R4: dispatch-contract completeness ---------------------------
        # For each workflow step that dispatches a task card, the step's
        # 'Context passed:' sub-bullet must supply every parameter named in the
        # dispatched task card's Entry Criteria.
        in_workflows = False
        step_context = None
        step_dispatch_target = None
        current_step = None
        for line in lines:
            stripped = line.strip()
            if stripped.startswith("## Workflows"):
                in_workflows = True
                continue
            if in_workflows and stripped.startswith("## "):
                in_workflows = False
                continue
            if not in_workflows:
                continue
            if re.match(r"^- \[ \] [0-9]", stripped):
                # Flush previous step's completeness check.
                findings.extend(
                    _check_dispatch_contract(rel, current_step, step_context, step_dispatch_target, skill_dir)
                )
                current_step = stripped
                step_context = None
                step_dispatch_target = None
                # The step header carries the dispatch prompt with the task-card
                # link — capture it here as the dispatch target.
                m = re.search(r"\]\(([^)]+)\)", stripped)
                if m:
                    step_dispatch_target = m.group(1)
                continue
            if "Context passed:" in stripped:
                m = re.search(r"\{([^}]*)\}", stripped)
                if m:
                    step_context = set(p.strip() for p in m.group(1).split(",") if p.strip())
                continue
            if "prompt:" in stripped.lower() or "Prompt" in stripped:
                m = re.search(r"\]\(([^)]+)\)", stripped)
                if m:
                    step_dispatch_target = m.group(1)
                continue
        findings.extend(
            _check_dispatch_contract(rel, current_step, step_context, step_dispatch_target, skill_dir)
        )

    return findings


def _check_dispatch_contract(
    rel: str,
    step_label: str | None,
    step_context: set[str] | None,
    dispatch_target: str | None,
    skill_dir: Path,
) -> list[LintFinding]:
    """Verify a workflow step's Context supplies every Entry Criteria parameter
    of the task card it dispatches (R4)."""
    import re
    if not step_label or not dispatch_target or step_context is None:
        return []
    task_path = (skill_dir / "tasks" / Path(dispatch_target).name).resolve()
    if not task_path.exists():
        task_path = (Path(rel).parent.parent / dispatch_target).resolve()
    if not task_path.exists():
        task_path = Path("/").joinpath(*dispatch_target.split("/")).resolve()
        if not task_path.exists():
            return []
    ttext = task_path.read_text()
    ec_match = re.search(r"^## Entry Criteria\s*$(.*?)(?=^## |\Z)", ttext, re.MULTILINE | re.DOTALL)
    if not ec_match:
        return []
    ec_body = ec_match.group(1)
    findings: list[LintFinding] = []
    # Only backtick-quoted identifier-like tokens (snake_case / dotted) are
    # dispatch-contract parameters. Path templates ({...}/...), prose mentions
    # (push-artifacts), and free text are not parameters.
    param_re = re.compile(r"`([a-zA-Z_][a-zA-Z0-9_]*(?:\.[a-zA-Z0-9_]+)*)`")
    for line in ec_body.splitlines():
        m = param_re.search(line)
        if not m:
            continue
        param = m.group(1)
        param = param.split(".")[0]
        if param in step_context:
            continue
        findings.append(LintFinding(
            severity="error", category="skill-format",
            source=rel, rule_id="dispatch-contract-incomplete",
            message=f"Workflow step '{step_label}' Context omits required parameter '{param}' required by {task_path.name}"
        ))
    return findings


def _resolve_task_card_link(target: str, base_dir: Path, skills_dir: Path, skill_dir: Path, task_file: Path) -> bool:
    """Resolve a task-card markdown link target against the candidate roots that
    the deck uses. Returns True if any candidate resolves to an existing file."""
    candidates = [
        (base_dir.parent / target).resolve(),  # repo-root-relative (.opencode/...)
        (base_dir / target).resolve(),        # .opencode/ dir-relative
        (skills_dir / target).resolve(),      # skills/ dir-relative
        (skill_dir / target).resolve(),       # skill dir-relative
        (task_file.parent / target).resolve(),  # task card dir-relative
    ]
    return any(c.exists() for c in candidates)


def lint_task_card_links(base_dir: Path) -> list[LintFinding]:
    """SC-44: flag broken markdown-link targets across task cards.

    A task-card body link that resolves to a non-existent file is a defect:
    the sub-agent cannot follow the reference. Only task-card bodies are
    scanned here; SKILL.md Workflows dispatch links are covered by R5.
    """
    import re
    findings: list[LintFinding] = []

    skills_dir = base_dir / "skills"
    if not skills_dir.exists():
        return findings

    global_ignore = _load_skilldeck_ignore(skills_dir / "reference")
    link_re = re.compile(r"\]\(([^)]+)\)")

    for skill_dir in sorted(skills_dir.iterdir()):
        if not skill_dir.is_dir():
            continue
        dir_ignore = _load_skilldeck_ignore(skill_dir)
        all_ignore = global_ignore | dir_ignore
        if _is_ignored(skill_dir, all_ignore, base_dir):
            continue

        tasks_dir = skill_dir / "tasks"
        if not (tasks_dir.exists() and tasks_dir.is_dir()):
            continue
        rel = str(skill_dir.relative_to(base_dir))

        for task_file in sorted(tasks_dir.glob("*.md")):
            ttext = task_file.read_text()
            for m in link_re.finditer(ttext):
                target = m.group(1)
                if target.startswith(("http://", "https://")):
                    continue
                if not target.endswith(".md"):
                    continue
                if "<" in target or "{" in target:
                    continue
                if not _resolve_task_card_link(target, base_dir, skills_dir, skill_dir, task_file):
                    findings.append(LintFinding(
                        severity="error", category="skill-format",
                        source=f"{rel}/tasks/{task_file.name}", rule_id="task-card-link-broken",
                        message=f"Task-card markdown link target does not exist: '{target}'"
                    ))
    return findings


def lint_task_card_frontmatter(base_dir: Path) -> list[LintFinding]:
    """SC-45: flag task cards that carry YAML frontmatter.

    Per task-card-structure-standards.md §1, task cards do NOT get YAML
    frontmatter — only SKILL.md files do. A task card whose first line is '---'
    carries frontmatter and must be flagged.
    """
    findings: list[LintFinding] = []

    skills_dir = base_dir / "skills"
    if not skills_dir.exists():
        return findings

    global_ignore = _load_skilldeck_ignore(skills_dir / "reference")

    for skill_dir in sorted(skills_dir.iterdir()):
        if not skill_dir.is_dir():
            continue
        dir_ignore = _load_skilldeck_ignore(skill_dir)
        all_ignore = global_ignore | dir_ignore
        if _is_ignored(skill_dir, all_ignore, base_dir):
            continue

        tasks_dir = skill_dir / "tasks"
        if not (tasks_dir.exists() and tasks_dir.is_dir()):
            continue
        rel = str(skill_dir.relative_to(base_dir))

        for task_file in sorted(tasks_dir.glob("*.md")):
            lines = task_file.read_text().split("\n")
            if lines and lines[0].strip() == "---":
                findings.append(LintFinding(
                    severity="error", category="skill-format",
                    source=f"{rel}/tasks/{task_file.name}", rule_id="task-card-frontmatter",
                    message="Task card carries YAML frontmatter (task cards must not have YAML frontmatter)"
                ))
    return findings


def _parse_returns_fields(raw: str) -> set[str]:
    """Parse the top-level field names of a Workflows 'Returns:' contract.

    Handles nested structures like '{status, verdicts: [{check_name, result}],
    finding_summary}' — only the top-level names (status, verdicts,
    finding_summary) are extracted; nested keys inside '{...}' blocks are
    ignored because they are structure detail, not top-level result fields.
    """
    import re
    fields: set[str] = set()
    for item in _split_top_level(raw):
        item = item.strip()
        if not item:
            continue
        name = item.split(":", 1)[0].strip().lstrip("{").strip()
        if re.match(r"^[a-zA-Z_][a-zA-Z0-9_]*$", name):
            fields.add(name)
    return fields


def _split_top_level(raw: str) -> list[str]:
    """Split a '{...}' contract on top-level commas, keeping nested '{...}'
    groups intact so nested fields are not split into pseudo top-level tokens.
    """
    parts: list[str] = []
    depth = 0
    current: list[str] = []
    for ch in raw:
        if ch == "{":
            depth += 1
            current.append(ch)
        elif ch == "}":
            depth = max(0, depth - 1)
            current.append(ch)
        elif ch == "," and depth == 0:
            parts.append("".join(current))
            current = []
        else:
            current.append(ch)
    if current:
        parts.append("".join(current))
    return parts


def _result_contract_fields(body: str) -> set[str]:
    """Extract the field names of a task card's Result Contract body.

    Handles both YAML key blocks (status:, artifact_path:) and plain
    comma/space lists (status, summary).
    """
    import re
    fields: set[str] = set()
    yaml_re = re.compile(r"^(\w+):", re.MULTILINE)
    for k in yaml_re.findall(body):
        fields.add(k)
    for line in body.splitlines():
        for tok in re.split(r"[,\s]+", line.strip()):
            if re.match(r"^[a-zA-Z_][a-zA-Z0-9_]*$", tok):
                fields.add(tok)
    return fields


def _check_dispatch_contract_completeness(
    rel: str,
    step_label: str | None,
    step_context: set[str] | None,
    step_returns: set[str] | None,
    dispatch_target: str | None,
    skill_dir: Path,
) -> list[LintFinding]:
    """SC-46: flag dispatch-contract completeness defects for a workflow step.

    B1: over-supplied/unconsumed Context params — a param passed in the step's
      'Context passed:' that the dispatched task card's Dispatch Contract does
      not accept.
    B2: result-contract field-name mismatch — a field in the step's 'Returns:'
      that does not match the dispatched task card's Result Contract field names.
    """
    import re
    if not step_label or not dispatch_target:
        return []
    if "<" in dispatch_target or "{" in dispatch_target:
        return []  # template link (e.g., <task>-investigator.md) — cannot resolve
    task_path = (skill_dir / "tasks" / Path(dispatch_target).name).resolve()
    if not task_path.exists():
        task_path = (Path(rel).parent.parent / dispatch_target).resolve()
    if not task_path.exists():
        task_path = Path("/").joinpath(*dispatch_target.split("/")).resolve()
        if not task_path.exists():
            return []
    ttext = task_path.read_text()

    findings: list[LintFinding] = []

    dc_match = re.search(r"^## Dispatch Contract\s*$(.*?)(?=^## |\Z)", ttext, re.MULTILINE | re.DOTALL)
    accepted: set[str] = set()
    if dc_match:
        param_re = re.compile(r"`([a-zA-Z_][a-zA-Z0-9_]*(?:\.[a-zA-Z0-9_]+)*)`")
        for line in dc_match.group(1).splitlines():
            mm = param_re.search(line)
            if mm:
                accepted.add(mm.group(1).split(".")[0])

    if step_context is not None and dc_match is not None:
        for param in sorted(step_context):
            if param not in accepted:
                findings.append(LintFinding(
                    severity="error", category="skill-format",
                    source=rel, rule_id="dispatch-contract-over-supplied",
                    message=f"Workflow step '{step_label}' Context supplies '{param}' which is not accepted by {task_path.name} Dispatch Contract (over-supplied/unconsumed)"
                ))

    rc_match = re.search(r"^## Result Contract\s*$(.*?)(?=^## |\Z)", ttext, re.MULTILINE | re.DOTALL)
    if step_returns is not None and rc_match is not None:
        rc_fields = _result_contract_fields(rc_match.group(1))
        for field in sorted(step_returns):
            if field not in rc_fields:
                findings.append(LintFinding(
                    severity="error", category="skill-format",
                    source=rel, rule_id="dispatch-contract-result-mismatch",
                    message=f"Workflow step '{step_label}' Returns field '{field}' does not match {task_path.name} Result Contract field names"
                ))
    return findings


def lint_dispatch_contract_completeness(base_dir: Path) -> list[LintFinding]:
    """SC-46: enforce dispatch-contract completeness across workflow steps.

    For every Workflows dispatch step that dispatches a task card, flag
    over-supplied/unconsumed Context params (B1) and result-contract field-name
    mismatches (B2).
    """
    import re
    findings: list[LintFinding] = []

    skills_dir = base_dir / "skills"
    if not skills_dir.exists():
        return findings

    global_ignore = _load_skilldeck_ignore(skills_dir / "reference")

    for skill_dir in sorted(skills_dir.iterdir()):
        if not skill_dir.is_dir():
            continue
        dir_ignore = _load_skilldeck_ignore(skill_dir)
        all_ignore = global_ignore | dir_ignore
        if _is_ignored(skill_dir, all_ignore, base_dir):
            continue

        skmd = skill_dir / "SKILL.md"
        if not skmd.exists():
            continue
        rel = str(skmd.relative_to(base_dir))
        text = skmd.read_text()
        lines = text.split("\n")

        in_workflows = False
        current_step = None
        step_context = None
        step_returns = None
        step_dispatch_target = None

        for line in lines:
            stripped = line.strip()
            if stripped.startswith("## Workflows"):
                in_workflows = True
                continue
            if in_workflows and stripped.startswith("## "):
                in_workflows = False
                continue
            if not in_workflows:
                continue
            if re.match(r"^- \[ \] [0-9]", stripped):
                findings.extend(_check_dispatch_contract_completeness(
                    rel, current_step, step_context, step_returns, step_dispatch_target, skill_dir))
                current_step = stripped
                step_context = None
                step_returns = None
                step_dispatch_target = None
                m = re.search(r"\]\(([^)]+)\)", stripped)
                if m:
                    step_dispatch_target = m.group(1)
                continue
            if "Context passed:" in stripped:
                m = re.search(r"\{([^}]*)\}", stripped)
                if m:
                    step_context = set(p.strip() for p in m.group(1).split(",") if p.strip())
                continue
            if "Returns:" in stripped:
                m = re.search(r"\{([^}]*)\}", stripped)
                if m:
                    step_returns = _parse_returns_fields(m.group(1))
                continue
            if "prompt:" in stripped.lower() or "Prompt" in stripped:
                m = re.search(r"\]\(([^)]+)\)", stripped)
                if m:
                    step_dispatch_target = m.group(1)
                continue

        findings.extend(_check_dispatch_contract_completeness(
            rel, current_step, step_context, step_returns, step_dispatch_target, skill_dir))

    return findings


def main() -> None:
    if _os.environ.get("OPENCODE_TOOLS_DISPATCHER") != "1":
        print(
            "ERROR: This script must be run via its dispatcher. Direct invocation is not permitted.",
            file=sys.stderr,
        )
        sys.exit(1)

    import argparse

    parser = argparse.ArgumentParser(description="Lint skill and guideline files")
    parser.add_argument("--dir", type=str, default=str(DEFAULT_SCAN_DIR))
    parser.add_argument("--skill", type=str, default="", help="Filter by skill name")
    parser.add_argument("--gate", type=str, default="", help="Filter by gate name")
    parser.add_argument("--scope", type=str, default="", help="Filter by scope")
    parser.add_argument("--json", action="store_true", help="Output as JSON")
    args = parser.parse_args()

    scan_dir = Path(args.dir)
    if not scan_dir.exists():
        print(f"Error: directory not found: {scan_dir}", file=sys.stderr)
        sys.exit(1)

    findings = lint_all(
        scan_dir,
        skill_filter=args.skill,
        gate_filter=args.gate,
        scope_filter=args.scope,
    )

    base_dir = scan_dir.parent if scan_dir.name == "skills" else scan_dir
    findings.extend(lint_progressive_disclosure(base_dir))
    findings.extend(lint_skill_frontmatter(base_dir))
    findings.extend(lint_skill_deck_completeness(base_dir))
    findings.extend(lint_skill_workflows_prompts(base_dir))
    findings.extend(lint_skill_card_format_rules(base_dir))
    findings.extend(lint_task_card_links(base_dir))
    findings.extend(lint_task_card_frontmatter(base_dir))
    findings.extend(lint_dispatch_contract_completeness(base_dir))

    if args.json:
        print(json.dumps([f.to_dict() for f in findings], indent=2))
    else:
        by_severity: dict[str, list[LintFinding]] = {}
        for f in findings:
            by_severity.setdefault(f.severity, []).append(f)
        print(f"Total findings: {len(findings)}")
        for sev in ("error", "warning", "info"):
            items = by_severity.get(sev, [])
            if items:
                print(f"\n{sev.upper()} ({len(items)}):")
                for item in items:
                    loc = f"{item.source}" + (
                        f" [{item.rule_id}]" if item.rule_id else ""
                    )
                    print(f"  {loc}: {item.message} ({item.category})")

if __name__ == "__main__":
    main()

