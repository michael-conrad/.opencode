def cmd_update(args: argparse.Namespace) -> None:
    _repo_name, args.number = _require_qualified(args.number)
    repo_path = _resolve_and_validate_repo(_repo_name)
    if not issue_exists(args.number, repo_path):
        _not_found(args.number, repo_path)
    path = get_issue_path(args.number, repo_path=repo_path) / "issue.yaml"
    issue = yaml_load(read_file(path))
    changed = False
    if args.labels is not None:
        args.labels = _normalize_labels(args.labels)
        _reject_malformed_labels(args.labels, "update")
    if args.body_file:
        body = read_file(Path(args.body_file))
        if body:
            issue["body"] = body
            changed = True
    for field in ("title", "status", "phase", "labels", "github", "remote_url"):
        val = getattr(args, field, None)
        if val is not None:
            key = field if field != "github" else "github_url"
            issue[key] = val
            changed = True
    if changed:
        issue["updated_at"] = now_iso()
        write_file(path, yaml_dump(issue))
    qualified = f"{_repo_name}#{args.number}"
