YAML_INDENT = 2
YAML_FILES = ("issue.yaml", "comments.yaml", "links.yaml")
MARKDOWN_FILES = ("spec.md",)

# SC-05 error-class taxonomy for warn-and-skip stderr warnings.
MALFORMED_FRONTMATTER = "malformed-frontmatter"
INVALID_YAML = "invalid-yaml"
SCHEMA_VIOLATION = "schema-violation"


def _warn_skip(rel: str, error_class: str, detail: Any = None) -> None:
    """Emit a warn-and-skip warning for a malformed record (SC-05).

    Warns to stderr with the offending file path and error class; the
    caller then skips the record. Never raises.
    """
    msg = f"warn: skipping {rel}: {error_class}"
    if detail is not None:
        msg += f": {str(detail).strip()}"
    print(msg, file=sys.stderr)


def _rel_issue_path(entry: Path, fname: str) -> str:
    """Relative display path of a file inside an issue directory."""
    return f"{entry.name}/{fname}"


def _schema_problem(kind: str, data: Any) -> str | None:
    """Return an error class if parsed YAML violates the record schema."""
    if kind == "links":
        if not isinstance(data, dict) or not isinstance(data.get("links"), list):
            return SCHEMA_VIOLATION
        return None
    if not isinstance(data, dict):
        return SCHEMA_VIOLATION
    return None


def _validate_issue_dir(entry: Path) -> None:
    """Warn-and-skip scan of one issue directory (SC-05).

    Emits stderr warnings (file path + error class) for malformed YAML
    records, schema violations, and malformed frontmatter. Completes
    exception-free; never mutates state.
    """
    for name in YAML_FILES:
        f = entry / name
        if not f.exists():
            continue
        rel = _rel_issue_path(entry, name)
        data = yaml_load(read_file(f), path=rel)
        problem = _schema_problem(name.removesuffix(".yaml"), data)
        if problem:
            _warn_skip(rel, problem)
    spec_file = entry / "spec.md"
    if spec_file.exists():
        spec = read_file(spec_file)
        if spec.startswith("---") and len(spec.split("---", 2)) < 3:
            _warn_skip(_rel_issue_path(entry, "spec.md"), MALFORMED_FRONTMATTER)


def _scan_issue_dir_errors(entry: Path) -> list[tuple[str, str]]:
    """Collect (path, error-class) findings for one issue directory (SC-06).

    Sweeps **/*.yaml under the issue directory: every YAML found is
    parse-validated (invalid-yaml on failure); the three canonical files
    retain their schema checks; non-canonical YAML (e.g. artifacts/*.yaml)
    is parse-validated only. Reuses the SC-05 error-class taxonomy
    (malformed-frontmatter, invalid-yaml, schema-violation) without
    emitting warn-and-skip warnings — callers own reporting. Read-only:
    never mutates files.
    """
    errors: list[tuple[str, str]] = []
    canonical = set(YAML_FILES)
    for f in sorted(entry.rglob("*.yaml")):
        rel = f"{entry.name}/{f.relative_to(entry)}"
        content = read_file(f)
        if not content.strip():
            continue
        try:
            data = yaml.safe_load(content)
        except yaml.YAMLError:
            errors.append((rel, INVALID_YAML))
            continue
        if f.name in canonical:
            problem = _schema_problem(f.name.removesuffix(".yaml"), data)
            if problem:
                errors.append((rel, problem))
    spec_file = entry / "spec.md"
    if spec_file.exists():
        spec = read_file(spec_file)
        if spec.startswith("---") and len(spec.split("---", 2)) < 3:
            errors.append((_rel_issue_path(entry, "spec.md"), MALFORMED_FRONTMATTER))
    return errors


def cmd_validate_yaml(args: argparse.Namespace) -> None:
    """Validate YAML across issue directories (SC-06, read-only).

    Without --number: walks .issues/<N>/ directories, reuses the SC-05
    error-class taxonomy, prints machine-greppable `<path>: <error-class>`
    report lines to stdout, and applies the exit-code gate: 0 clean, 1
    when malformed files are found. Never mutates files.

    With --number <repo>#N (SC-1, issue 2450): scans ONLY the target
    issue directory, resolved via the existing exact-match lookup, using
    the same shared scan machinery and report format. Scoped exit
    semantics: exit 0 on a clean target regardless of unrelated
    workspace violations; exit 1 when the target's own files violate.
    When the target directory does not exist locally (remote-only
    issue), exits 0 printing a no-local-records status line. Bare
    unqualified numbers are rejected.
    """
    scoped_number = getattr(args, "number", None)
    if scoped_number is not None:
        repo_name, num = _require_qualified(scoped_number)
        repo_path = _resolve_and_validate_repo(repo_name)
        target = _find_issue_dir_in_repo(num, repo_path)
        if target is None:
            print(f"no-local-records: {repo_name}#{num}")
            return
        errors = _scan_issue_dir_errors(target)
        for rel, error_class in errors:
            print(f"{rel}: {error_class}")
        if errors:
            sys.exit(1)
        return

    issues_dir = Path(ISSUES_DIR)
    errors: list[tuple[str, str]] = []
    if issues_dir.is_dir():
        for entry in sorted(issues_dir.iterdir()):
            if not entry.is_dir():
                continue
            errors.extend(_scan_issue_dir_errors(entry))
    for rel, error_class in errors:
        print(f"{rel}: {error_class}")
    if errors:
        sys.exit(1)


def _find_issue_dir(number: int, repo_path: Path | None = None) -> Path | None:
    """Find issue directory by exact number match.

    Matches `.issues/<number>` only. Returns None if no match.
    """
    issues_dir = (repo_path or PROJECT_DIR) / ISSUES_DIR
    exact = issues_dir / str(number)
    if exact.is_dir():
        return exact
    return None


def _find_issue_dir_in_repo(number: int, repo_path: Path) -> Path | None:
    """Find issue directory by exact number within a specific repo path."""
    issues_dir = repo_path / ISSUES_DIR
    exact = issues_dir / str(number)
    if exact.is_dir():
        return exact
    return None


def _repo_has_issue(number: int, repo_path: Path) -> bool:
    path = _find_issue_dir_in_repo(number, repo_path)
    if not path or not path.is_dir():
        return False
    return True


def _slug(text: str, max_len: int = 60) -> str:
    """Convert a title to a filesystem-safe slug."""
    slug = re.sub(r"[^a-zA-Z0-9]+", "-", text.lower()).strip("-")
    return slug[:max_len].rstrip("-")


def get_issue_path(
    number: int, title: str | None = None, repo_path: Path | None = None
) -> Path:
    dir_path = _find_issue_dir(number, repo_path)
    if dir_path is not None:
        return dir_path
    return (repo_path or PROJECT_DIR) / ISSUES_DIR / str(number)


def read_file(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return ""


def write_file(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


def yaml_dump(data: Any) -> str:
    return yaml.dump(
        data,
        indent=YAML_INDENT,
        default_flow_style=False,
        sort_keys=False,
        allow_unicode=True,
    )


def yaml_load(content: str, path: str | None = None) -> Any:
    """Parse YAML content, warn-and-skip on parse errors (SC-05).

    On a YAML parse error, emits a stderr warning carrying the source
    file path (when provided) and the invalid-yaml error class, then
    returns an empty dict so iteration paths skip the malformed record
    exception-free.
    """
    if not content.strip():
        return {}
    try:
        return yaml.safe_load(content)
    except yaml.YAMLError as exc:
        _warn_skip(path or "<memory>", INVALID_YAML, exc)
        return {}


def issue_exists(number: int, repo_path: Path | None = None) -> bool:
    path = get_issue_path(number, repo_path=repo_path)
    return path.is_dir()


def read_issue_data(number: int, repo_path: Path | None = None) -> dict:
    path = get_issue_path(number, repo_path=repo_path)
    result = {}
    has_yaml = False
    for name in YAML_FILES:
        f = path / name
        if f.exists():
            has_yaml = True
            content = read_file(f)
        else:
            content = ""
        result[name.removesuffix(".yaml")] = yaml_load(
            content, path=_rel_issue_path(path, name)
        )
    # If no YAML files exist, fall back to spec.md for backward compatibility
    if not has_yaml:
        spec = read_file(path / "spec.md")
        if spec:
            if spec.startswith("---"):
                parts = spec.split("---", 2)
                if len(parts) >= 3:
                    fm = yaml_load(parts[1])
                    body = parts[2].strip()
                    if isinstance(fm, dict):
                        fm["body"] = body
                        result["issue"] = fm
                else:
                    _warn_skip(
                        _rel_issue_path(path, "spec.md"),
                        MALFORMED_FRONTMATTER,
                    )
            else:
                # Plain markdown with no frontmatter — treat entire file as body
                result["issue"] = {"body": spec.strip(), "status": "open"}
    return result


ARTIFACT_ONLY_STATUS = "artifact-only"


def _read_issue_title_status(entry: Path) -> tuple[str, str]:
    """Read title and status from an issue directory entry.

    Returns the ARTIFACT_ONLY_STATUS sentinel when the directory holds
    only artifact files (e.g. spec.md) without issue.yaml — readers stay
    total functions and never raise.
    """
    issue_file = entry / "issue.yaml"
    if issue_file.exists():
        data = yaml_load(
            read_file(issue_file), path=_rel_issue_path(entry, "issue.yaml")
        )
        if isinstance(data, dict):
            return data.get("title", ""), data.get("status", "open")
    if any(p.is_file() for p in entry.iterdir()):
        # Any metadata yaml variant (spec.md, comments.yaml, links.yaml,
        # ...) without issue.yaml is an artifact-only directory.
        return "", ARTIFACT_ONLY_STATUS
    return "", "open"


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def _worktree_active(repo_path: Path | None = None) -> bool:
    """Check if .issues/ is a linked worktree (orphan issues branch)."""
    root = repo_path or Path(os.getcwd())
    gitlink = root / ISSUES_DIR / ".git"
    return gitlink.is_file()


def _issues_branch_exists(repo_path: Path | None = None) -> bool:
    """Check if the issues branch exists locally."""
    git_dir = str(repo_path) if repo_path else os.getcwd()
    result = subprocess.run(
        [
            "git",
            "-C",
            git_dir,
            "rev-parse",
            "--verify",
            "--quiet",
            f"refs/heads/{WORKTREE_BRANCH}",
        ],
        capture_output=True,
        timeout=15,
    )
    return result.returncode == 0


def _discover_all_repos() -> list[Path]:
    """Discover parent repo + child repos via .gitmodules parsing.

    Root repo is always first. Child repos come exclusively from
    .gitmodules entries. No filesystem glob, no worktree detection.
    """
    root = PROJECT_DIR.resolve()
    repos: list[Path] = [root]

    gitmodules = root / ".gitmodules"
    if not gitmodules.exists():
        return repos

    config = configparser.ConfigParser()
    config.read(str(gitmodules))
    for section in config.sections():
        if not section.startswith("submodule "):
            continue
        path_val = config.get(section, "path", fallback="")
        if not path_val:
            continue
        child = (root / path_val).resolve()
        if child.is_dir() and child not in repos:
            repos.append(child)

    return repos


def _has_remote(repo_path: Path | None = None) -> bool:
    """Check if any git remote is configured for this repo."""
    if repo_path is None:
        repo_path = Path.cwd()
    result = subprocess.run(
        ["git", "-C", str(repo_path), "remote", "get-url", "origin"],
        capture_output=True, text=True, timeout=15,
    )
    return result.returncode == 0 and bool(result.stdout.strip())


def _get_local_branches(repo_path: str, *names: str) -> list[str]:
    """Return list of branch names that exist locally from the given names."""
    result = subprocess.run(
        ["git", "-C", repo_path, "branch", "--list", *names],
        capture_output=True,
        text=True,
        timeout=15,
    )
    if result.returncode != 0:
        print(f"warn: branch list failed: {result.stderr.strip()}", file=sys.stderr)
        return []
    found: list[str] = []
    for line in result.stdout.split("\n"):
        stripped = line.strip()
        if stripped.startswith("* ") or stripped.startswith("+ "):
            branch = stripped[2:]
        else:
            branch = stripped
        if branch:
            found.append(branch)
    return found


def _get_branch_divergence(repo_path: str, branch_a: str, branch_b: str) -> str:
    """Return ahead/behind counts between two branches."""
    result = subprocess.run(
        [
            "git",
            "-C",
            repo_path,
            "rev-list",
            "--left-right",
            "--count",
            f"{branch_a}...{branch_b}",
        ],
        capture_output=True,
        text=True,
        timeout=15,
    )
    if result.returncode != 0:
        print(
            f"warn: branch divergence check failed: {result.stderr.strip()}",
            file=sys.stderr,
        )
    return result.stdout.strip()


def _get_branch_timestamps(repo_path: str, *branches: str) -> str:
    """Return commit timestamps for one or more branches."""
    result = subprocess.run(
        [
            "git",
            "-C",
            repo_path,
            "log",
            "--oneline",
            "--format=%ci %s",
            *branches,
        ],
        capture_output=True,
        text=True,
        timeout=15,
    )
    if result.returncode != 0:
        print(f"warn: branch log failed: {result.stderr.strip()}", file=sys.stderr)
    return result.stdout.strip()


def _get_branch_info(repo: Path) -> dict | None:
    """Check if repo has both 'issues' and 'issues-data' branches; return info dict or None."""
    repo_path = str(repo)
    branches = _get_local_branches(repo_path, "issues", "issues-data")
    if "issues" not in branches or "issues-data" not in branches:
        return None
    return {
        "repo": repo_path,
        "branches": ["issues", "issues-data"],
        "timestamps": _get_branch_timestamps(repo_path, "issues", "issues-data"),
        "divergence": _get_branch_divergence(repo_path, "issues", "issues-data"),
        "auto_merge": False,
    }


def _format_dual_branch_output(dual: dict) -> str:
    """Format dual-branch info dict into a human-readable string."""
    return (
        f"repo: {dual['repo']}\n"
        f"branches: {', '.join(dual['branches'])}\n"
        f"timestamps:\n{dual['timestamps']}\n"
        f"divergence: {dual['divergence']}"
    )


def _detect_dual_branch() -> dict | None:
    """Check if both 'issues' and 'issues-data' branches exist in any repo."""
    repos = _discover_all_repos()
    for repo in repos:
        info = _get_branch_info(repo)
        if info is not None:
            return info
    return None


def _ensure_all_worktrees() -> bool:
    """Ensure worktrees exist in current repo and all discovered child repos."""
    repos = _discover_all_repos()
    all_ok = True
    for repo in repos:
        try:
            if not _ensure_worktree(repo_path=repo):
                all_ok = False
        except Exception as e:
            print(f"warn: worktree setup failed for {repo}: {e}", file=sys.stderr)
            all_ok = False
    return all_ok


def _create_orphan_branch(root: Path) -> bool:
    """Create the orphan issues-data branch via git plumbing.

    Empty tree object (git hash-object -t tree /dev/null) → git
    commit-tree onto it → git update-ref refs/heads/issues-data. No temp
    worktree exists at any point; no porcelain commit runs, so hook
    contact is structurally impossible; the branch tree is empty by
    construction; zero-commit repositories are supported. Returns True
    on success, False on failure.
    """
    git_dir = str(root)
    tree = subprocess.run(
        ["git", "-C", git_dir, "hash-object", "-t", "tree", "/dev/null"],
        capture_output=True, text=True, timeout=15,
    )
    if tree.returncode != 0:
        print(f"warn: empty tree hash failed: {tree.stderr.strip()}", file=sys.stderr)
        return False
    commit = subprocess.run(
        [
            "git", "-C", git_dir, "commit-tree", tree.stdout.strip(),
            "-m", "Init issues branch",
        ],
        capture_output=True, text=True, timeout=15,
    )
    if commit.returncode != 0:
        print(f"warn: commit-tree failed: {commit.stderr.strip()}", file=sys.stderr)
        return False
    ref = subprocess.run(
        [
            "git", "-C", git_dir, "update-ref",
            f"refs/heads/{WORKTREE_BRANCH}", commit.stdout.strip(),
        ],
        capture_output=True, text=True, timeout=15,
    )
    if ref.returncode != 0:
        print(f"warn: update-ref failed: {ref.stderr.strip()}", file=sys.stderr)
        return False
    return True


def _bootstrap_from_remote(root: Path) -> bool:
    """Bootstrap the issues branch from origin/issues-data when present.

    Fetches the remote branch and creates a local tracking branch. Returns
    True when the local branch was created from the remote ref. Returns
    False when the remote branch is verified absent — the caller then
    falls back to the orphan-branch path.

    A failed fetch is NOT treated as "remote absent" (#2548 C4): the
    remote branch's existence is verified via ls-remote, and when it
    exists (or existence cannot be verified because the network is
    down) establishment fails fatally instead of minting a fresh empty
    orphan that would diverge from the real remote history.
    """
    fetch = subprocess.run(
        [
            "git",
            "-C",
            str(root),
            "fetch",
            "--quiet",
            "origin",
            WORKTREE_BRANCH,
        ],
        capture_output=True,
        text=True,
        timeout=30,
    )
    if fetch.returncode != 0:
        # Disambiguate fetch failure from a genuinely absent remote ref.
        ls_remote = subprocess.run(
            [
                "git",
                "-C",
                str(root),
                "ls-remote",
                "--heads",
                "origin",
                WORKTREE_BRANCH,
            ],
            capture_output=True,
            text=True,
            timeout=30,
        )
        if ls_remote.returncode != 0 or ls_remote.stdout.strip():
            _fail_worktree(
                root,
                (
                    f"fetch of origin/{WORKTREE_BRANCH} failed "
                    f"({fetch.stderr.strip()}); remote branch exists or "
                    "existence cannot be verified — retry when the network "
                    "recovers; never bootstrap an empty orphan over real "
                    "remote history"
                ),
            )
        print(
            f"warn: remote branch {WORKTREE_BRANCH} verified absent on origin; "
            "creating orphan branch",
            file=sys.stderr,
        )
        return False
    verify = subprocess.run(
        [
            "git",
            "-C",
            str(root),
            "rev-parse",
            "--verify",
            "--quiet",
            f"refs/remotes/origin/{WORKTREE_BRANCH}",
        ],
        capture_output=True,
        text=True,
        timeout=15,
    )
    if verify.returncode != 0:
        return False
    branch = subprocess.run(
        [
            "git",
            "-C",
            str(root),
            "branch",
            "--track",
            WORKTREE_BRANCH,
            f"origin/{WORKTREE_BRANCH}",
        ],
        capture_output=True,
        text=True,
        timeout=15,
    )
    if branch.returncode != 0:
        print(
            f"warn: failed to create tracking branch {WORKTREE_BRANCH}: "
            f"{branch.stderr.strip()}",
            file=sys.stderr,
        )
        return False
    return True


def _migrate_existing_issues(root: Path) -> list[tuple[str, str, str]]:
    """Save existing .issues/ content before worktree takeover.

    Returns list of (kind, name, content_or_path) tuples.
    """
    issues_dir = root / ISSUES_DIR
    saved: list[tuple[str, str, str]] = []
    if not issues_dir.is_dir():
        return saved
    if not any(issues_dir.iterdir()):
        return saved

    for item in issues_dir.iterdir():
        if item.name == ".git":
            continue
        if item.is_dir():
            import tempfile

            tmpdir = tempfile.mkdtemp()
            dst = os.path.join(tmpdir, item.name)
            shutil.copytree(str(item), dst)
            saved.append(("dir", item.name, dst))
        else:
            content = item.read_text(encoding="utf-8")
            saved.append(("file", item.name, content))
    return saved


def _restore_migrated_content(root: Path, saved: list[tuple[str, str, str]]) -> None:
    """Restore previously saved .issues/ content into the worktree."""
    issues_dir = root / ISSUES_DIR
    for kind, name, payload in saved:
        dst = issues_dir / name
        if kind == "dir":
            src_tmp = Path(payload)
            shutil.copytree(str(src_tmp), str(dst), dirs_exist_ok=True)
            shutil.rmtree(src_tmp.parent)
        elif kind == "file":
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.write_text(payload, encoding="utf-8")


def _setup_worktree(root: Path) -> bool:
    """Create the .issues/ worktree from the issues-data branch.

    Returns True on success, False on failure.
    """
    git_dir = str(root)
    issues_dir = root / ISSUES_DIR

    # Remove the parent repo's .issues/ so the worktree can take over
    if issues_dir.is_dir():
        shutil.rmtree(str(issues_dir))

    wt_add_result = subprocess.run(
        ["git", "-C", git_dir, "worktree", "add", str(issues_dir), WORKTREE_BRANCH],
        capture_output=True,
        text=True,
        timeout=15,
    )
    if wt_add_result.returncode != 0:
        print(
            f"warn: worktree add failed: {wt_add_result.stderr.strip()}",
            file=sys.stderr,
        )
        return False
    return True


def _find_issues_worktree(git_dir: str) -> str | None:
    """Return the path of the issues worktree if listed, else None."""
    result = subprocess.run(
        ["git", "-C", git_dir, "worktree", "list"],
        capture_output=True,
        text=True,
        timeout=15,
    )
    if result.returncode != 0:
        return None
    for line in result.stdout.strip().split("\n"):
        parts = line.split()
        if len(parts) >= 2 and parts[1] == f"[{WORKTREE_BRANCH}]":
            return parts[0]
    return None


def _prune_stale_worktree(git_dir: str, wt_path: str) -> None:
    """Prune a stale worktree entry whose directory no longer exists."""
    if os.path.isdir(wt_path):
        return
    r = subprocess.run(
        ["git", "-C", git_dir, "worktree", "prune"],
        capture_output=True,
        text=True,
        timeout=15,
    )
    if r.returncode != 0:
        print(f"warn: worktree prune failed: {r.stderr.strip()}", file=sys.stderr)


def _create_issues_worktree(root: Path) -> bool:
    """Create the issues worktree: migrate, branch, setup, restore, push."""
    saved = _migrate_existing_issues(root)
    if not _issues_branch_exists(repo_path=root):
        if not _bootstrap_from_remote(root) and not _create_orphan_branch(root):
            print("error: failed to create orphan issues-data branch", file=sys.stderr)
            return False
    if not _setup_worktree(root):
        return False
    _restore_migrated_content(root, saved)
    _push_orphan_if_needed(repo_path=root)
    return True


def _fail_worktree(root: Path, detail: str) -> None:
    """Exit non-zero: worktree establishment failed (fail-fatal contract).

    No caller continues in plain-file mode; no plain .issues/ directory
    is created or written after this fires.
    """
    issues_dir = root / ISSUES_DIR
    print(
        f"error: failed to establish {WORKTREE_BRANCH} worktree for {root}: {detail}",
        file=sys.stderr,
    )
    print(
        f"  remediation: git -C {root} worktree add {issues_dir} {WORKTREE_BRANCH}",
        file=sys.stderr,
    )
    sys.exit(1)


def _ensure_worktree(repo_path: Path | None = None) -> bool:
    """
    Ensure a git worktree is available for issue tracking (fail-fatal).

    Detection logic:
    1. Check if already inside a worktree (_worktree_active returns True)
    2. Check if worktree already exists via git worktree list
    3. Check if stale worktree (listed but directory missing) -> prune + recreate
    4. If no worktree exists on 'issues' branch:
       a. If 'issues' branch exists, create worktree from it
       b. If 'issues' branch doesn't exist, bootstrap from remote or create
          orphan branch + worktree
    5. Any failure is terminal: exit non-zero with a diagnostic naming the
       failure and the remediation command. There is no plain-file
       fallback mode; no plain .issues/ directory is created on failure.

    Returns: True if worktree is active (never returns False).
    """
    root = repo_path or Path(os.getcwd())
    git_dir = str(root)

    if _worktree_active(repo_path=root):
        return True

    try:
        issues_wt_path = _find_issues_worktree(git_dir)
        if issues_wt_path is not None and os.path.isdir(issues_wt_path):
            return True
        if issues_wt_path is not None:
            _prune_stale_worktree(git_dir, issues_wt_path)
        if not _create_issues_worktree(root):
            _fail_worktree(root, "worktree setup failed")
        return True

    except SystemExit:
        raise
    except Exception as e:
        _fail_worktree(root, str(e))


def _count_issues(repo_path: Path) -> int:
    """Count issue directories by _parse_number() in a repo's .issues/ dir."""
    issues_dir = repo_path / ISSUES_DIR
    if not issues_dir.is_dir():
        return 0
    count = 0
    seen: set[int] = set()
    for entry in sorted(issues_dir.iterdir()):
        num = _parse_number(entry)
        if num is not None and num not in seen:
            seen.add(num)
            count += 1
    return count


def _collect_repos() -> list[tuple[Path, str]]:
    """Collect (repo_path, qualifier) for current repo and all child repos."""
    current = Path(os.getcwd()).resolve()
    current_name = _resolve_repo_name()
    repos: list[tuple[Path, str]] = [(current, current_name)]
    seen: set[str] = {current_name}
    for child in _discover_all_repos():
        if child.name not in seen:
            seen.add(child.name)
            repos.append((child.resolve(), child.name))
    return repos


def _is_https_without_creds(git_dir: str) -> bool:
    """Check if the remote is HTTPS and no credential helper is configured.

    Returns True when push would trigger an interactive auth prompt.
    """
    try:
        url_result = subprocess.run(
            ["git", "-C", git_dir, "remote", "get-url", "origin"],
            capture_output=True, text=True, timeout=15,
        )
        if url_result.returncode != 0:
            return False
        remote_url = url_result.stdout.strip()
        if not remote_url.startswith("https://"):
            return False
        cred_result = subprocess.run(
            ["git", "-C", git_dir, "config", "--get-all", "credential.helper"],
            capture_output=True, text=True, timeout=15,
        )
        return cred_result.returncode != 0 or not cred_result.stdout.strip()
    except Exception:
        return False


def _push_orphan_if_needed(repo_path: Path | None = None) -> None:
    """Push the worktree branch to origin if a remote exists.

    Skips push when remote is HTTPS without credential helper to avoid
    hanging on interactive auth prompts in non-interactive environments (#1299).
    """
    git_dir = str(repo_path) if repo_path else os.getcwd()
    if _is_https_without_creds(git_dir):
        return
    try:
        result = subprocess.run(
            ["git", "-C", git_dir, "remote", "get-url", "origin"],
            capture_output=True,
            text=True,
            timeout=15,
        )
        if result.returncode != 0:
            return
        branch = WORKTREE_BRANCH
        push_result = subprocess.run(
            ["git", "-C", git_dir, "push", "-u", "origin", branch],
            capture_output=True,
            text=True,
            timeout=30,
        )
        if push_result.returncode != 0:
            print(
                f"warn: push orphan branch failed: {push_result.stderr.strip()}",
                file=sys.stderr,
            )
    except Exception as e:
        print(f"warn: failed to push orphan branch {branch}: {e}", file=sys.stderr)


def _push_issues_branch(repo_path: Path | None = None) -> None:
    """
    Push the issues worktree branch to origin.
    Only called from _auto_commit after a mutation commit.
    Runs git commands from within .issues/ (the linked worktree).

    Skips push when remote is HTTPS without credential helper (#1299).
    """
    root = repo_path or Path(os.getcwd())
    if not _worktree_active(repo_path=root):
        return
    issues_git_dir = str(root / ISSUES_DIR)
    if _is_https_without_creds(issues_git_dir):
        return
    try:
        result = subprocess.run(
            ["git", "-C", issues_git_dir, "remote", "get-url", "origin"],
            capture_output=True,
            text=True,
            timeout=15,
        )
        if result.returncode != 0:
            return
        push_result = subprocess.run(
            ["git", "-C", issues_git_dir, "push", "origin", WORKTREE_BRANCH],
            capture_output=True,
            text=True,
            timeout=30,
        )
        if push_result.returncode != 0:
            print(
                f"warn: push issues branch failed: {push_result.stderr.strip()}",
                file=sys.stderr,
            )
    except Exception as e:
        print(f"warn: failed to push issues branch: {e}", file=sys.stderr)


def _stage_issues_changes(root: Path) -> bool:
    """Stage all changes in the issues worktree. Returns True if there were changes."""
    issues_git_dir = str(root / ISSUES_DIR)
    result = subprocess.run(
        ["git", "-C", issues_git_dir, "status", "--porcelain"],
        capture_output=True,
        text=True,
        timeout=15,
    )
    if not result.stdout.strip():
        return False
    add_result = subprocess.run(
        ["git", "-C", issues_git_dir, "add", "-A"],
        capture_output=True,
        text=True,
        timeout=15,
    )
    if add_result.returncode != 0:
        print(f"warn: git add failed: {add_result.stderr.strip()}", file=sys.stderr)
    return True


def _commit_issues_changes(root: Path, msg: str) -> None:
    """Commit staged changes in the issues worktree."""
    issues_git_dir = str(root / ISSUES_DIR)
    commit_result = subprocess.run(
        ["git", "-C", issues_git_dir, "commit", "-m", msg, "--allow-empty"],
        capture_output=True,
        text=True,
        timeout=15,
    )
    if commit_result.returncode != 0:
        print(
            f"warn: git commit failed: {commit_result.stderr.strip()}",
            file=sys.stderr,
        )


# Transient push/rebase failure markers (#2548 C2) — retried once, then
# reported. Non-transient failures (non-fast-forward, rejected) are NOT
# retried; retrying cannot help and would mask divergence.
TRANSIENT_GIT_MARKERS = (
    "connection closed",
    "connection refused",
    "connection reset",
    "could not read from remote repository",
    "the remote end hung up",
    "timed out",
    "early eof",
    "temporarily unavailable",
    "name or service not known",
    "temporary failure in name resolution",
    "ssl",
)

# Sync statuses that mean the store failed to converge (#2548 C2). Steady
# states (no_worktree, no_remote) are informational and do not fail sync.
SYNC_FAILURE_STATUSES = (
    "add_failed",
    "commit_failed",
    "push_failed",
    "conflict",
    "timeout",
    "rebase_in_progress",
)


def _is_transient_git_error(stderr: str) -> bool:
    low = stderr.lower()
    return any(marker in low for marker in TRANSIENT_GIT_MARKERS)


def _push_with_retry(args: list[str], timeout: int) -> subprocess.CompletedProcess:
    """Run a git push once, retrying a single time on transient failure."""
    result = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    if result.returncode != 0 and _is_transient_git_error(result.stderr):
        time.sleep(1)
        result = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    return result


def _push_issues_changes(root: Path) -> None:
    """Push the issues worktree branch to origin.

    Skips push when remote is HTTPS without credential helper (#1299).
    Retries once on transient network failures (#2548 C2).
    """
    issues_git_dir = str(root / ISSUES_DIR)
    if _is_https_without_creds(issues_git_dir):
        return
    try:
        result = subprocess.run(
            ["git", "-C", issues_git_dir, "remote", "get-url", "origin"],
            capture_output=True,
            text=True,
            timeout=15,
        )
        if result.returncode != 0:
            return
        push_result = _push_with_retry(
            ["git", "-C", issues_git_dir, "push", "origin", WORKTREE_BRANCH], 30
        )
        if push_result.returncode != 0:
            print(
                f"warn: push issues branch failed: {push_result.stderr.strip()}",
                file=sys.stderr,
            )
    except Exception as e:
        print(f"warn: failed to push issues branch: {e}", file=sys.stderr)


def _auto_commit(message: str = "", repo_path: Path | None = None) -> None:
    """
    Auto-commit changes on the issues worktree branch after a mutation.

    Runs git commands from within .issues/ (the linked worktree checkout of
    the orphan issues branch). Only commits if worktree is active and there
    are changes. Silently skips if no changes or not in worktree.
    After commit, pushes the issues branch to origin.
    """
    root = repo_path or Path(os.getcwd())
    if not _worktree_active(repo_path=root):
        return
    try:
        if not _stage_issues_changes(root):
            return
        msg_local = message or "auto: update issue"
        _commit_issues_changes(root, msg_local)
    except Exception as e:
        print(f"warn: auto-commit failed: {e}", file=sys.stderr)
    _push_issues_changes(root)


def _check_duplicate_issue(number: int, repo_path: Path, repo_name: str) -> None:
    """Exit with error if issue number already exists in the target repo.

    Uniqueness is enforced within the target repo's own .issues/{N}
    namespace only. Remote trackers number per-repo and the qualified
    form (repo#N) mandated on every command disambiguates collisions —
    no cross-repo check or warning is performed.

    Honors _parse_number semantics (#2548 C6): any directory that parses
    to the requested number (including legacy {N}-{slug} names) blocks
    creation — exact-name matching alone let a second dir for the same
    number be minted.
    """
    if issue_exists(number, repo_path):
        print(
            f"Issue #{number} already exists in {repo_name}.",
            file=sys.stderr,
        )
        sys.exit(1)
    issues_dir = (repo_path or PROJECT_DIR) / ISSUES_DIR
    if issues_dir.is_dir():
        for entry in issues_dir.iterdir():
            if entry.is_dir() and _parse_number(entry) == number:
                print(
                    f"Issue #{number} already exists in {repo_name} "
                    f"(directory '{entry.name}' parses to this number).",
                    file=sys.stderr,
                )
                sys.exit(1)


def _normalize_labels(labels: list[str]) -> list[str]:
    """Normalize label tokens: split on commas, strip whitespace, drop empties."""
    result: list[str] = []
    for token in labels:
        for part in token.split(","):
            part = part.strip()
            if part:
                result.append(part)
    return result


def _reject_malformed_labels(labels: list[str], command: str) -> None:
    """Exit with a CLI error if any label token is structurally malformed.

    Called after normalization, before any file mutation or _auto_commit.
    A token is malformed if it is empty or still contains whitespace
    (inner spaces/tabs cannot be resolved by normalization).
    """
    for label in labels:
        if not label or any(ch.isspace() for ch in label):
            print(
                f"error: malformed label token {label!r} passed to "
                f"{command} --labels (whitespace/empty not resolvable by "
                "normalization); no changes were written",
                file=sys.stderr,
            )
            sys.exit(2)


def _ensure_needs_approval(labels: list[str]) -> list[str]:
    """Ensure 'needs-approval' is always in the labels list, first."""
    result = ["needs-approval"]
    for label in labels:
        if label != "needs-approval":
            result.append(label)
    return result


def _create_issue_files(
    number: int, title: str, labels: list[str], repo_path: Path, qualified: str
) -> None:
    path = get_issue_path(number, title, repo_path)
    labels = _ensure_needs_approval(labels)
    issue = {
        "title": title,
        "status": "open",
        "labels": labels,
        "body": "",
        "created_at": now_iso(),
        "updated_at": now_iso(),
    }
    write_file(path / "issue.yaml", yaml_dump(issue))
    write_file(path / "comments.yaml", "comments: []\n")
    write_file(path / "links.yaml", "links: []\n")
    print(yaml_dump({"created": True, "number": qualified, "title": title}))
    _auto_commit(f"auto: create #{qualified}", repo_path)


def cmd_create(args: argparse.Namespace) -> None:
    dual = _detect_dual_branch()
    if dual:
        print(f"warn: dual-branch detected in {dual['repo']}", file=sys.stderr)
        print(f"  branches: {', '.join(dual['branches'])}", file=sys.stderr)
        print(f"  divergence (left/right count): {dual['divergence']}", file=sys.stderr)
        if dual["timestamps"]:
            print("  commit history:", file=sys.stderr)
            for line in dual["timestamps"].split("\n"):
                if line.strip():
                    print(f"    {line}", file=sys.stderr)
        print(
            "  action: no auto-merge — compare data above and resolve manually",
            file=sys.stderr,
        )
    repo_name, num = _require_qualified(args.number)
    repo_path = _resolve_and_validate_repo(repo_name)
    current_repo_name = repo_path.name
    args.number = num
    qualified = f"{current_repo_name}#{args.number}"
    _check_duplicate_issue(args.number, repo_path, current_repo_name)
    labels = _normalize_labels(args.labels)
    _reject_malformed_labels(labels, "create")
    _ensure_worktree(repo_path=repo_path)
    _create_issue_files(args.number, args.title, labels, repo_path, qualified)


def _recent_issue_numbers(repo_path: Path | None = None) -> list[int]:
    """Return up to 5 most recent issue numbers from .issues/ dirs."""
    issues_dir = (repo_path or PROJECT_DIR) / ISSUES_DIR
    if not issues_dir.is_dir():
        return []
    nums: set[int] = set()
    for entry in issues_dir.iterdir():
        num = _parse_number(entry)
        if num is not None:
            nums.add(num)
    sorted_nums = sorted(nums, reverse=True)
    return sorted_nums[:5]


def _parse_qualified(value: str) -> tuple[str | None, int]:
    """Parse 'repo#N' format. Returns (repo_name, number) or (None, number) for bare."""
    match = re.match(r"^(.+?)#(\d+)$", value.strip())
    if match:
        return (match.group(1), int(match.group(2)))
    return (None, int(value.strip()))


def _require_qualified(number_str: str) -> tuple[str, int]:
    """Parse qualified form, error on bare numbers."""
    bare = number_str.strip()
    repo_name, num = _parse_qualified(bare)
    if repo_name is None:
        print(
            f"Error: bare number '{bare}' requires a repo qualifier — use repo#{bare}.",
            file=sys.stderr,
        )
        _print_available_repos()
        sys.exit(1)
    return repo_name, num


def _resolve_repo_path(repo_name: str) -> Path | None:
    """Resolve repo name to its filesystem Path.

    Checks current repo first, then discovered child repos.
    Returns None if not found.
    """
    current = Path(os.getcwd()).resolve()
    current_name = _resolve_repo_name()
    if repo_name == current_name:
        return current
    for child in _discover_all_repos():
        if child.name == repo_name:
            return child.resolve()
    return None


def _resolve_and_validate_repo(repo_name: str) -> Path:
    """Resolve repo name and return the resolved path."""
    repo_path = _resolve_repo_path(repo_name)
    if repo_path is None:
        print(f"Error: repo '{repo_name}' not found.", file=sys.stderr)
        _print_available_repos()
        sys.exit(1)
    return repo_path


def _resolve_qualified(qualified_str: str) -> list[tuple[Path, str, str]]:
    """Resolve qualified 'repo#N' or bare 'N' to list of (repo_path, repo_name, number_str).

    For bare N: returns all repos (current first, children alphabetically per SC-13).
    For qualified: returns single matching repo. Exits with error if not found.
    """
    repo_name_val, number = _parse_qualified(qualified_str)
    number_str = str(number)
    current = Path(os.getcwd()).resolve()
    current_name = _resolve_repo_name()

    if repo_name_val is not None:
        if repo_name_val == current_name:
            return [(current, current_name, number_str)]
        for child in _discover_all_repos():
            if child.name == repo_name_val:
                return [(child.resolve(), child.name, number_str)]
        print(f"error: repo '{repo_name_val}' not found", file=sys.stderr)
        _print_available_repos()
        sys.exit(1)

    results: list[tuple[Path, str, str]] = [(current, current_name, number_str)]
    seen: set[str] = {current_name}
    for child in _discover_all_repos():
        if child.name not in seen:
            seen.add(child.name)
            results.append((child.resolve(), child.name, number_str))
    return results


def _read_issue_data_in_repo(number: int, repo_path: Path) -> dict:
    path = _find_issue_dir_in_repo(number, repo_path)
    if not path:
        return {}
    result = {}
    has_yaml = False
    for name in YAML_FILES:
        f = path / name
        if f.exists():
            has_yaml = True
            content = read_file(f)
        else:
            content = ""
        result[name.removesuffix(".yaml")] = yaml_load(
            content, path=_rel_issue_path(path, name)
        )
    if not has_yaml:
        spec = read_file(path / "spec.md")
        if spec:
            if spec.startswith("---"):
                parts = spec.split("---", 2)
                if len(parts) >= 3:
                    fm = yaml_load(parts[1])
                    body = parts[2].strip()
                    if isinstance(fm, dict):
                        fm["body"] = body
                        result["issue"] = fm
                else:
                    _warn_skip(
                        _rel_issue_path(path, "spec.md"),
                        MALFORMED_FRONTMATTER,
                    )
            else:
                result["issue"] = {"body": spec.strip()}
    return result


def _spec_path_for_issue(number: int, repo_path: Path) -> str:
    current = Path(os.getcwd()).resolve()
    issue_dir = _find_issue_dir_in_repo(number, repo_path)
    if issue_dir:
        try:
            return str(issue_dir.relative_to(current))
        except ValueError:
            return str(issue_dir)
    return ""


def _read_issue_entry(number: int, repo_path: Path, repo_name: str) -> dict:
    data = _read_issue_data_in_repo(number, repo_path)
    return {
        "repo": repo_name,
        "number": number,
        "spec_path": _spec_path_for_issue(number, repo_path),
        "issue": data.get("issue", {}),
    }


def _collect_read_results(
    targets: list[tuple[Path, str, str]],
) -> list[dict]:
    matches: list[dict] = []
    for repo_path, repo_name, number_str in targets:
        number = int(number_str)
        if _repo_has_issue(number, repo_path):
            matches.append(_read_issue_entry(number, repo_path, repo_name))
    return matches


def _not_found(number: int, repo_path: Path | None = None) -> None:
    recent = _recent_issue_numbers(repo_path)
    msg = f"Issue #{number} not found."
    if recent:
        msg += f" Recent issue numbers: {', '.join(f'#{n}' for n in recent)}"
    print(msg, file=sys.stderr)
    sys.exit(1)


def cmd_read(args: argparse.Namespace) -> None:
    _require_qualified(args.number)
    targets = _resolve_qualified(args.number)
    matches = _collect_read_results(targets)
    if not matches:
        _, number = _parse_qualified(args.number)
        _not_found(number)
    if len(targets) == 1 and targets[0][1] != _resolve_repo_name():
        repo_path, repo_name, number_str = targets[0]
        number = int(number_str)
        print(yaml_dump(_read_issue_entry(number, repo_path, repo_name)))
    elif len(matches) <= 1:
        print(yaml_dump(matches[0] if matches else {}))
    else:
        print(yaml_dump({"matches": matches}))


