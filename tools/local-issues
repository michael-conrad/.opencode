def _doctor_remote_branch_exists(repo_path: Path) -> bool:
    """Check if refs/remotes/origin/issues-data exists (read-only)."""
    result = subprocess.run(
        [
            "git",
            "-C",
            str(repo_path),
            "rev-parse",
            "--verify",
            "--quiet",
            f"refs/remotes/origin/{WORKTREE_BRANCH}",
        ],
        capture_output=True,
        timeout=15,
    )
    return result.returncode == 0


def _doctor_repo_report(repo: Path) -> str:
    """Build one machine-greppable health-marker line for a repo (read-only).

    Markers: repo=<path> branch_state={HEALTHY|UNHEALTHY}
    merge_base_delta={absent|<ahead>/<behind>} worktree={active|absent}
    """
    issues_dir = repo / ISSUES_DIR
    local_exists = _issues_branch_exists(repo_path=repo)
    branch_state = "HEALTHY" if local_exists else "UNHEALTHY"
    if local_exists and _doctor_remote_branch_exists(repo):
        raw = _get_branch_divergence(
            str(repo), WORKTREE_BRANCH, f"origin/{WORKTREE_BRANCH}"
        )
        parts = raw.split()
        delta = f"{parts[0]}/{parts[1]}" if len(parts) == 2 else raw or "absent"
    else:
        delta = "absent"
    worktree = "active" if (issues_dir / ".git").is_file() else "absent"
    return (
        f"repo={repo} issues_dir={issues_dir} branch_state={branch_state} "
        f"merge_base_delta={delta} worktree={worktree}"
    )


def cmd_doctor(args: argparse.Namespace) -> None:
    """Emit per-repo health markers for root and all discovered repos.

    Read-only: never mutates state (no worktree bootstrap, no sentinel
    files).
    """
    for repo in _discover_all_repos():
        try:
            print(f"doctor {_doctor_repo_report(repo)}")
        except Exception as e:
            print(
                f"doctor repo={repo} branch_state=UNKNOWN error={e}",
                file=sys.stderr,
            )


