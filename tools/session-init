import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

_parent_dir = Path(__file__).resolve().parent
if str(_parent_dir) not in sys.path:
    sys.path.insert(0, str(_parent_dir))

from session_init.auth import check_cli_auth_status  # type: ignore[import-untyped]
from session_init import fork_stamp  # type: ignore[import-untyped]

GIT_TIMEOUT = 10

_path = Path(__file__).resolve().parent
while _path.name != ".opencode":
    parent = _path.parent
    if parent == _path:
        raise RuntimeError("Could not find .opencode/ directory")
    _path = parent
PROJECT_ROOT = _path.parent


def run_git_command(args: list[str]) -> str | None:
    """Run a git command and return output, or None if failed."""
    try:
        result = subprocess.run(
            ["git"] + args,
            capture_output=True,
            text=True,
            check=False,
            stdin=subprocess.DEVNULL,
            timeout=GIT_TIMEOUT,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except subprocess.TimeoutExpired:
        pass
    except (subprocess.SubprocessError, OSError):
        pass
    return None


def get_user_name() -> str:
    """Get git user name or fallback to $USER."""
    name = run_git_command(["config", "user.name"])
    if name:
        return name
    return os.environ.get("USER", "unknown")


def get_user_email() -> str:
    """Get git user email or fallback to $USER@$HOSTNAME."""
    email = run_git_command(["config", "user.email"])
    if email:
        return email
    user = os.environ.get("USER", "unknown")
    hostname = os.environ.get("HOSTNAME", "localhost")
    return f"{user}@{hostname}"


def parse_repo_url(url: str) -> tuple[str, str, str] | tuple[None, None, None]:
    """Parse owner, repo, and platform (bare hostname) from any git remote URL.

    Supports:
    - SSH: git@HOSTNAME:OWNER/REPO.git
    - HTTPS: https://HOSTNAME/OWNER/REPO.git
    - SSH with port: ssh://git@HOSTNAME:PORT/OWNER/REPO.git

    Returns:
        (owner, repo, platform) on success, (None, None, None) on failure.
        platform is the bare hostname from the URL.
    """
    ssh_port_pattern = r"^ssh://git@([^:/]+):(\d+)/([^/]+)/([^/]+?)(?:\.git)?$"
    match = re.match(ssh_port_pattern, url)
    if match:
        return match.group(3), match.group(4), match.group(1)

    ssh_short_pattern = r"^git@([^:]+):([^/]+)/([^/]+?)(?:\.git)?$"
    match = re.match(ssh_short_pattern, url)
    if match:
        return match.group(2), match.group(3), match.group(1)

    https_pattern = r"^https://([^/]+)/([^/]+)/([^/]+?)(?:\.git)?$"
    match = re.match(https_pattern, url)
    if match:
        return match.group(2), match.group(3), match.group(1)

    return None, None, None


def get_remote_url() -> str | None:
    """Get origin remote URL or None if not configured."""
    return run_git_command(["remote", "get-url", "origin"])


def get_current_branch() -> str | None:
    """Get current git branch name or None if HEAD is detached."""
    return run_git_command(["branch", "--show-current"])


def _is_issues_store_path(path: str) -> bool:
    """True for issue-store worktree paths (.issues, .opencode/.issues).

    Stores are orphan-branch worktrees, not repos in their own right —
    their identity duplicates the parent repo entry (#2549 change 2).
    """
    return path == ".issues" or path.endswith("/.issues")


def collect_repo_info() -> list[dict[str, str]]:
    """Collect all repo identity entries.

    Returns a list of dicts with keys: path, owner, repo, platform, url.
    Root entry always first; subdirectory entries follow. Issue-store
    worktrees are skipped — real repos only; each entry later carries an
    `issues:` field naming its store path.
    """
    entries: list[dict[str, str]] = []
    cwd = os.getcwd()
    remote_url = get_remote_url()

    # Root entry
    if remote_url:
        owner, repo, platform = parse_repo_url(remote_url)
        if not owner or not repo:
            owner = "(unknown)"
            repo = "(unknown)"
        url_str = remote_url
    else:
        owner = "(none)"
        repo = "(none)"
        platform = "local"
        url_str = "(none)"

    entries.append({
        "path": ".",
        "owner": owner,
        "repo": repo,
        "platform": platform or "unknown",
        "url": url_str,
    })

    # Subdirectory scan: immediate subdirs with .git entries
    try:
        dir_entries = sorted(os.listdir(cwd))
    except OSError:
        return entries

    for entry_name in dir_entries:
        entry_path = os.path.join(cwd, entry_name)
        if not os.path.isdir(entry_path):
            continue
        git_path = os.path.join(entry_path, ".git")
        if not os.path.exists(git_path):
            continue
        if _is_issues_store_path(entry_name):
            continue
        sub_url = run_git_command(["-C", entry_name, "remote", "get-url", "origin"])
        if not sub_url:
            continue
        sub_owner, sub_repo, sub_platform = parse_repo_url(sub_url)
        if not sub_owner or not sub_repo:
            continue
        entries.append({
            "path": entry_name,
            "owner": sub_owner,
            "repo": sub_repo,
            "platform": sub_platform or "unknown",
            "url": sub_url,
        })

    # Submodule recursion: one level deep into each submodule directory
    # (issue-store worktrees like .opencode/.issues/ are skipped above —
    # they are stores, not repos)
    for entry_name in dir_entries:
        entry_path = os.path.join(cwd, entry_name)
        if not os.path.isdir(entry_path):
            continue
        git_path = os.path.join(entry_path, ".git")
        if not os.path.exists(git_path):
            continue
        try:
            nested_entries = sorted(os.listdir(entry_path))
        except OSError:
            continue
        for nested_name in nested_entries:
            nested_path = os.path.join(entry_path, nested_name)
            if not os.path.isdir(nested_path):
                continue
            nested_git = os.path.join(nested_path, ".git")
            if not os.path.exists(nested_git):
                continue
            nested_rel = f"{entry_name}/{nested_name}"
            if _is_issues_store_path(nested_rel):
                continue
            nested_url = run_git_command(["-C", nested_path, "remote", "get-url", "origin"])
            if not nested_url:
                continue
            nested_owner, nested_repo, nested_platform = parse_repo_url(nested_url)
            if not nested_owner or not nested_repo:
                continue
            entries.append({
                "path": f"{entry_name}/{nested_name}",
                "owner": nested_owner,
                "repo": nested_repo,
                "platform": nested_platform or "unknown",
                "url": nested_url,
            })

    return entries


def get_source_hooks_dir() -> str | None:
    """Find the .opencode/hooks/ directory or None if missing."""
    hooks_dir = os.path.join(os.getcwd(), ".opencode", "hooks")
    if os.path.isdir(hooks_dir):
        return hooks_dir
    return None


def get_hooks_path() -> str:
    """Get git hooks path or empty string if not configured."""
    hooks = run_git_command(["config", "core.hooksPath"])
    return hooks or ""


def _hooks_match(src: str, dst: str) -> bool:
    """Check if two hook files have the same content."""
    try:
        return os.path.isfile(dst) and open(src).read() == open(dst).read()
    except OSError:
        return False


def _copy_hook(src: str, dst: str) -> bool:
    """Copy a hook file, making it executable."""
    try:
        shutil.copy2(src, dst)
        os.chmod(dst, 0o755)
        return True
    except OSError:
        return False


def _resolve_git_dir() -> str | None:
    """Resolve the actual .git directory using git rev-parse --git-dir."""
    result = run_git_command(["rev-parse", "--git-dir"])
    if not result:
        return None
    cwd = os.getcwd()
    if os.path.isabs(result):
        return result
    return os.path.normpath(os.path.join(cwd, result))


def _resolve_hooks_target(repo_dir: str) -> str | None:
    """Resolve the effective hooks directory for a repo via git itself.

    Property-based (no gitdir-layout guessing): `git rev-parse --git-path
    hooks` returns the path git actually reads hooks from for that repo —
    the submodule's module gitdir for submodules, and the common .git/hooks
    for linked worktrees (which then dedupes with the root install).
    """
    result = run_git_command(["-C", repo_dir, "rev-parse", "--git-path", "hooks"])
    if not result:
        return None
    if os.path.isabs(result):
        return os.path.normpath(result)
    return os.path.normpath(os.path.join(repo_dir, result))


def _install_hooks_into(target_hooks_dir: str, source_dir: str, source_hooks: list[str]) -> None:
    """Copy source hooks into a target hooks directory, making them executable."""
    os.makedirs(target_hooks_dir, exist_ok=True)
    for hook_name in source_hooks:
        src = os.path.join(source_dir, hook_name)
        dst = os.path.join(target_hooks_dir, hook_name)
        if _hooks_match(src, dst):
            continue
        _copy_hook(src, dst)


def install_hooks() -> None:
    """Install git hooks from .opencode/hooks/ into every repo in the workspace.

    Covers the root repo and every linked repo discovered by collect_repo_info,
    including .git-file submodules (resolved via `rev-parse --git-path hooks`).
    Linked worktrees resolve to the common hooks dir and dedupe naturally.
    Reports failures to stderr.
    """
    source_dir = get_source_hooks_dir()
    if not source_dir:
        return

    source_hooks = [
        f
        for f in os.listdir(source_dir)
        if os.path.isfile(os.path.join(source_dir, f)) and not f.endswith(".sample")
    ]
    if not source_hooks:
        return

    installed_dirs: list[str] = []

    git_dir = _resolve_git_dir()
    if git_dir:
        parent_hooks_dir = os.path.join(git_dir, "hooks")
    else:
        parent_hooks_dir = os.path.join(os.getcwd(), ".git", "hooks")
    _install_hooks_into(parent_hooks_dir, source_dir, source_hooks)
    installed_dirs.append(parent_hooks_dir)

    linked_repos = collect_repo_info()
    for repo_entry in linked_repos:
        dir_name = repo_entry["path"]
        if dir_name == "." or not os.path.isdir(dir_name):
            continue

        target = _resolve_hooks_target(os.path.join(os.getcwd(), dir_name))
        if not target:
            continue
        normalized = os.path.normpath(target)
        if normalized in [os.path.normpath(d) for d in installed_dirs]:
            continue
        _install_hooks_into(normalized, source_dir, source_hooks)
        installed_dirs.append(normalized)

    if get_hooks_path():
        run_git_command(["config", "--unset", "core.hooksPath"])


def collect_hook_inventory() -> list[str]:
    """Report-only hook inventory: trunk-check hook presence per repo.

    Verification and visibility only — never installs, never blocks.
    """
    source_dir = get_source_hooks_dir()
    lines: list[str] = []
    source_names: list[str] = []
    if source_dir:
        source_names = sorted(
            f
            for f in os.listdir(source_dir)
            if os.path.isfile(os.path.join(source_dir, f)) and not f.endswith(".sample")
        )
    names = ", ".join(source_names) if source_names else "none"
    lines.append(f"- hook source: .opencode/hooks/ ({names})")

    for repo in collect_repo_info():
        path = repo["path"]
        repo_dir = os.getcwd() if path == "." else os.path.join(os.getcwd(), path)
        target = _resolve_hooks_target(repo_dir)
        if not target or not os.path.isdir(target):
            lines.append(f"- {path}: hooks target not resolvable")
            continue
        states = []
        for name in source_names:
            dst = os.path.join(target, name)
            if not os.path.isfile(dst):
                states.append(f"{name}: MISSING")
            elif _hooks_match(os.path.join(source_dir, name), dst):
                states.append(f"{name}: ok")
            else:
                states.append(f"{name}: stale")
        lines.append(f"- {path}: {'; '.join(states) if states else 'no trunk hooks installed'}")
    return lines


def _extract_version_from_pyproject() -> str:
    """Extract version string from pyproject.toml, or return '0.1.0' as fallback."""
    pyproject_path = os.path.join(os.getcwd(), "pyproject.toml")
    if os.path.isfile(pyproject_path):
        try:
            with open(pyproject_path) as f:
                for line in f:
                    stripped = line.strip()
                    if stripped.startswith("version"):
                        parts = stripped.split("=", 1)
                        if len(parts) == 2:
                            return parts[1].strip().strip('"').strip("'")
        except OSError:
            pass
    return "0.1.0"





def detect_worktree() -> tuple[bool, str | None, str | None]:
    toplevel = run_git_command(["rev-parse", "--show-toplevel"])
    if not toplevel:
        return False, None, None

    git_path = os.path.join(toplevel, ".git")
    if os.path.isfile(git_path):
        try:
            with open(git_path) as f:
                content = f.read().strip()
            if content.startswith("gitdir: "):
                gitdir = content[8:]
                if not os.path.isabs(gitdir):
                    gitdir = os.path.join(toplevel, gitdir)
                worktrees_dir = os.path.dirname(os.path.abspath(gitdir))
                git_dir = os.path.dirname(worktrees_dir)
                if (
                    os.path.basename(git_dir) == ".git"
                    and os.path.basename(worktrees_dir) == "worktrees"
                ):
                    main_repo = os.path.dirname(git_dir)
                    return True, toplevel, main_repo
        except OSError:
            pass

    return False, None, None


def is_submodule_context() -> bool:
    toplevel = run_git_command(["rev-parse", "--show-toplevel"])
    if not toplevel:
        return False
    git_path = os.path.join(toplevel, ".git")
    if os.path.isfile(git_path):
        try:
            with open(git_path) as f:
                content = f.read().strip()
            if content.startswith("gitdir: "):
                gitdir = content[8:]
                if not os.path.isabs(gitdir):
                    gitdir = os.path.join(toplevel, gitdir)
                gitdir = os.path.normpath(gitdir)
                if ".git" in os.path.normpath(gitdir).split(
                    os.sep
                ) and "modules" in os.path.normpath(gitdir).split(os.sep):
                    return True
        except OSError:
            pass
    return False


def _add_to_gitignore(entry: str) -> bool:
    """Add an entry to .gitignore if not already present."""
    gitignore_path = os.path.join(os.getcwd(), ".gitignore")
    try:
        existing_lines: list[str] = []
        if os.path.isfile(gitignore_path):
            with open(gitignore_path) as f:
                existing_lines = f.read().splitlines()
        if entry in existing_lines:
            return True
        with open(gitignore_path, "a") as f:
            if existing_lines and existing_lines[-1] != "":
                f.write("\n")
            f.write(f"{entry}\n")
        return True
    except OSError:
        return False


CREDENTIAL_FILE_PATTERNS = [
    (".env", "Environment variables file"),
    (".streamlit/secrets.toml", "Streamlit secrets file"),
    (".streamlit/secrets.toml.production", "Streamlit production secrets file"),
]


def _check_credential_files_gitignored() -> list[str]:
    """Check credential files for gitignore coverage.

    Returns a list of warning messages for unprotected credential files.
    Empty list means all credential files are safe (gitignored or absent).
    """
    gitignore_path = os.path.join(os.getcwd(), ".gitignore")
    gitignore_entries: set[str] = set()
    if os.path.isfile(gitignore_path):
        try:
            with open(gitignore_path) as f:
                for line in f:
                    stripped = line.strip()
                    if stripped and not stripped.startswith("#"):
                        gitignore_entries.add(stripped)
        except OSError:
            pass

    unprotected: list[str] = []
    for filepath, description in CREDENTIAL_FILE_PATTERNS:
        full_path = os.path.join(os.getcwd(), filepath)
        if not os.path.isfile(full_path):
            continue
        if filepath in gitignore_entries or f"/{filepath}" in gitignore_entries:
            continue
        result = run_git_command(["check-ignore", filepath])
        if result is None:
            unprotected.append(
                f"WARNING: {filepath} ({description}) is NOT in .gitignore — secrets may be committed"
            )
    return unprotected


def run_guard_checks() -> list[str]:
    """Run guard checks silently. Returns list of problem descriptions."""
    problems: list[str] = []
    unprotected = _check_credential_files_gitignored()
    problems.extend(unprotected)
    return problems


def collect_issue_artifact_paths(repo_info: list[dict[str, str]]) -> list[str]:
    """Collect local .issues/ folder entries for each repo entry.

    Emits one vocabulary line stating that local artifacts for a qualified
    reference `repo#N` live at that repo's `issues:` path under `{N}/`
    (#2549 change 3), then one `git -C` pointer per repo whose store
    exists — or a setup hint naming `local-issues init` when the store is
    absent (fresh clones bootstrap the store on first init).
    """
    cwd = os.getcwd()
    entries: list[str] = [
        "- Local artifacts for a qualified reference repo#N live at that "
        "repo's `issues:` path under {N}/ — read from the store first; the "
        "remote issue body is a condensed exec summary only."
    ]
    for repo in repo_info:
        repo_path = repo["path"]
        # Skip .issues worktrees — they are the issue store, not repos
        # with their own issue folders
        if repo_path == ".issues" or repo_path.endswith("/.issues"):
            continue
        if repo_path == ".":
            issues_rel = ".issues/"
            issues_abs = os.path.join(cwd, ".issues")
        else:
            issues_rel = f"{repo_path}/.issues/"
            issues_abs = os.path.join(cwd, repo_path, ".issues")
        if os.path.exists(issues_abs):
            entries.append(f"- {issues_rel}: git -C {issues_rel}")
        else:
            entries.append(
                f"- {issues_rel}: absent — run ./.opencode/tools/local-issues init "
                "to bootstrap the issue store worktree"
            )
    return entries


def get_agent_tools_help() -> str:
    """Run ./.opencode/tools/help and return tool listing or error message."""
    try:
        result = subprocess.run(
            [".opencode/tools/help"],
            capture_output=True,
            text=True,
            check=False,
            stdin=subprocess.DEVNULL,
            timeout=GIT_TIMEOUT,
            cwd=str(PROJECT_ROOT),
        )
        if result.returncode == 0:
            return result.stdout.rstrip("\n")
        return f"Error: tools/help exited with code {result.returncode}"
    except subprocess.TimeoutExpired:
        return f"Error: tools/help timed out after {GIT_TIMEOUT}s"
    except (subprocess.SubprocessError, OSError) as e:
        return f"Error: tools/help failed: {e}"


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--description":
        print("Session initialization script for AI agents.")
        return 0
    repo_info = collect_repo_info()

    user_name = get_user_name()
    user_email = get_user_email()

    guard_problems = run_guard_checks()
    if is_submodule_context():
        pass
    else:
        install_hooks()

    in_wt, wt_path, main_repo = detect_worktree()
    hooks_path = get_hooks_path()

    now = datetime.now().astimezone()
    print(f"Session started: {now.strftime('%A, %B %d, %Y at %I:%M %p')} {now.tzname()}")
    print("This session start time indicates your training data is extremely stale and always must be re-researched before making factual claims — never trust training data without live verification.")

    print(f"Developer: {user_name}")
    print(f"Email: {user_email}")

    if in_wt and wt_path and main_repo:
        print(f"Worktree: {wt_path}")

    if hooks_path:
        print(f"Git hooks: {hooks_path}")

    for problem in guard_problems:
        print(problem)

    # Emit ## CLI Auth Status section — only if at least one CLI is installed
    cli_status = check_cli_auth_status()
    if cli_status:
        print("## CLI Auth Status")
        for line in cli_status:
            print(line)

    # Emit ## Hook Inventory — report-only verification of the trunk-check hook
    print("## Hook Inventory (report-only)")
    for line in collect_hook_inventory():
        print(line)

    # Emit ## Local Issue Folders section
    issue_folders = collect_issue_artifact_paths(repo_info)
    print("## Local Issue Folders")
    for cmd in issue_folders:
        print(cmd)

    # Emit unified ## Repo Information section
    # Fork stamps: local, untrusted context — informational only, never a
    # routing input. The probe itself is spawned detached, fire-and-forget;
    # any failure here is silent (no annotation, no warnings).
    fork_parents: dict[str, str] = {}
    try:
        fork_stamp.spawn_background_probe(repo_info)
        git_common_dir = fork_stamp.run_git_command_quiet(
            ["git", "rev-parse", "--git-common-dir"]
        )
        if git_common_dir:
            if not os.path.isabs(git_common_dir):
                git_common_dir = os.path.abspath(git_common_dir)
            fork_parents = fork_stamp.fresh_fork_parents(
                fork_stamp.load_stamps(git_common_dir)
            )
    except Exception:
        fork_parents = {}
    print("## Repo Information")
    print("Professional engineers route issue operations by matching affected file paths to the `path` prefix below, then using that entry's `owner` and `repo`. Amateurs default to root and route to the wrong repo.")
    for entry in repo_info:
        print(f"- path: {entry['path']}")
        print(f"  owner: {entry['owner']}")
        print(f"  repo: {entry['repo']}")
        print(f"  platform: {entry['platform']}")
        print(f"  url: {entry['url']}")
        # Store path for qualified-reference resolution: local artifacts
        # for repo#N live under {issues}/{N}/ (#2549 change 2)
        if entry["path"] == ".":
            print("  issues: .issues/")
        else:
            print(f"  issues: {entry['path']}/.issues/")
        parent = fork_parents.get(entry["url"])
        if parent:
            print(f"  fork_of: {parent}")

    # Emit project_root — absolute top-level git root for submodule-aware path resolution
    project_root = run_git_command(["rev-parse", "--show-toplevel"])
    print(f"project_root: {project_root}")

    # Emit ## Agent Tools section with tool listing
    tools_help = get_agent_tools_help()
    print("## Agent Tools")
    print(tools_help)

    return 0


if __name__ == "__main__":
    sys.exit(main())

