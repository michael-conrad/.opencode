def run_git_command(args: list[str]) -> str | None:
    """Run a git command and return output, or None if failed."""
    try:
        result = subprocess.run(
            ["git"] + args,
            capture_output=True,
            text=True,
            check=False,
            stdin=subprocess.DEVNULL,
            timeout=GIT_TIMEOUT,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except subprocess.TimeoutExpired:
        pass
    except (subprocess.SubprocessError, OSError):
        pass
    return None


def get_user_name() -> str:
    """Get git user name or fallback to $USER."""
    name = run_git_command(["config", "user.name"])
    if name:
        return name
    return os.environ.get("USER", "unknown")


def get_user_email() -> str:
    """Get git user email or fallback to $USER@$HOSTNAME."""
    email = run_git_command(["config", "user.email"])
    if email:
        return email
    user = os.environ.get("USER", "unknown")
    hostname = os.environ.get("HOSTNAME", "localhost")
    return f"{user}@{hostname}"


def parse_repo_url(url: str) -> tuple[str, str, str] | tuple[None, None, None]:
    """Parse owner, repo, and platform (bare hostname) from any git remote URL.

    Supports:
    - SSH: git@HOSTNAME:OWNER/REPO.git
    - HTTPS: https://HOSTNAME/OWNER/REPO.git
    - SSH with port: ssh://git@HOSTNAME:PORT/OWNER/REPO.git

    Returns:
        (owner, repo, platform) on success, (None, None, None) on failure.
        platform is the bare hostname from the URL.
    """
    ssh_port_pattern = r"^ssh://git@([^:/]+):(\d+)/([^/]+)/([^/]+?)(?:\.git)?$"
    match = re.match(ssh_port_pattern, url)
    if match:
        return match.group(3), match.group(4), match.group(1)

    ssh_short_pattern = r"^git@([^:]+):([^/]+)/([^/]+?)(?:\.git)?$"
    match = re.match(ssh_short_pattern, url)
    if match:
        return match.group(2), match.group(3), match.group(1)

    https_pattern = r"^https://([^/]+)/([^/]+)/([^/]+?)(?:\.git)?$"
    match = re.match(https_pattern, url)
    if match:
        return match.group(2), match.group(3), match.group(1)

    return None, None, None


def get_remote_url() -> str | None:
    """Get origin remote URL or None if not configured."""
    return run_git_command(["remote", "get-url", "origin"])


def get_current_branch() -> str | None:
    """Get current git branch name or None if HEAD is detached."""
    return run_git_command(["branch", "--show-current"])


def _is_wiki_origin(url: str) -> bool:
    """True when a git origin URL points at a wiki repo (#2544).

    Origin-based, not wiring-based: the final path segment ending in
    `.wiki` or `.wiki.git` marks a wiki repo whether it is wired as an
    ignored sub-repo or a registered submodule. GitHub/GitBucket wikis
    render only from the default branch and have no branch/PR mechanism —
    trunk-protection hooks would block every publish.
    """
    segment = re.split(r"[/\\:]", url.rstrip("/"))[-1]
    return segment.endswith(".wiki") or segment.endswith(".wiki.git")


def _registered_submodule_paths(repo_dir: str) -> list[str]:
    """Paths of a repo's registered submodules (#2544 strict discovery).

    Enumerates `.gitmodules` entries, each verified present in
    `git submodule status` output — git's registered-submodule mechanism is
    the authoritative answer to which child repos the workspace orchestrates;
    filesystem shape is not.
    """
    gitmodules = run_git_command([
        "-C", repo_dir, "config", "-f", ".gitmodules",
        "--get-regexp", r"submodule\..*\.path",
    ])
    if not gitmodules:
        return []
    status = run_git_command(["-C", repo_dir, "submodule", "status"]) or ""
    status_paths = {
        line.split()[1]
        for line in status.splitlines()
        if len(line.split()) >= 2
    }
    paths: list[str] = []
    for line in gitmodules.splitlines():
        value = line.partition(" ")[2].strip()
        if value and value in status_paths:
            paths.append(value)
    return sorted(paths)


def collect_repo_info() -> list[dict[str, str]]:
    """Collect all repo identity entries.

    Returns a list of dicts with keys: path, owner, repo, platform, url.
    Root entry always first; child entries follow. Discovery is strictly
    git's registered-submodule mechanism applied over the registered tree
    (transitively, #2544 item 1) — ignored sub-repos are never enumerated.
    A registered entry is covered only when a checkout is present
    (uninitialized submodules produce no entry) and the checkout's
    `remote.origin.url` exists and parses to an owner/repo pair (no
    `.gitmodules` fallback). Wiki-origin repos (`.wiki`/`.wiki.git`) are
    excluded at every level (#2544 item 2). Each entry later carries an
    `issues:` field naming its store path.
    """
    entries: list[dict[str, str]] = []
    cwd = os.getcwd()
    remote_url = get_remote_url()

    # Root entry
    if remote_url:
        owner, repo, platform = parse_repo_url(remote_url)
        if not owner or not repo:
            owner = "(unknown)"
            repo = "(unknown)"
        url_str = remote_url
    else:
        owner = "(none)"
        repo = "(none)"
        platform = "local"
        url_str = "(none)"

    entries.append({
        "path": ".",
        "owner": owner,
        "repo": repo,
        "platform": platform or "unknown",
        "url": url_str,
    })

    def walk(base_dir: str, base_rel: str) -> None:
        for name in _registered_submodule_paths(base_dir):
            child_dir = os.path.join(base_dir, name)
            child_rel = f"{base_rel}/{name}" if base_rel else name
            if not os.path.exists(os.path.join(child_dir, ".git")):
                continue  # no checkout (uninitialized) — no coverage
            sub_url = run_git_command(["-C", child_dir, "remote", "get-url", "origin"])
            if not sub_url:
                continue
            sub_owner, sub_repo, sub_platform = parse_repo_url(sub_url)
            if not sub_owner or not sub_repo:
                continue
            if _is_wiki_origin(sub_url):
                continue  # wiki repos are never hooked and never inventoried
            entries.append({
                "path": child_rel,
                "owner": sub_owner,
                "repo": sub_repo,
                "platform": sub_platform or "unknown",
                "url": sub_url,
            })
            walk(child_dir, child_rel)

    walk(cwd, "")
    return entries


def get_source_hooks_dir() -> str | None:
    """Find the .opencode/hooks/ directory or None if missing."""
    hooks_dir = os.path.join(os.getcwd(), ".opencode", "hooks")
    if os.path.isdir(hooks_dir):
        return hooks_dir
    return None


def get_hooks_path() -> str:
    """Get git hooks path or empty string if not configured."""
    hooks = run_git_command(["config", "core.hooksPath"])
    return hooks or ""


def _hooks_match(src: str, dst: str) -> bool:
    """Check if two hook files have the same content."""
    try:
        return os.path.isfile(dst) and open(src).read() == open(dst).read()
    except OSError:
        return False


def _copy_hook(src: str, dst: str) -> bool:
    """Copy a hook file, making it executable."""
    try:
        shutil.copy2(src, dst)
        os.chmod(dst, 0o755)
        return True
    except OSError:
        return False


def _resolve_git_dir() -> str | None:
    """Resolve the actual .git directory using git rev-parse --git-dir."""
    result = run_git_command(["rev-parse", "--git-dir"])
    if not result:
        return None
    cwd = os.getcwd()
    if os.path.isabs(result):
        return result
    return os.path.normpath(os.path.join(cwd, result))


def _resolve_hooks_target(repo_dir: str) -> str | None:
    """Resolve the effective hooks directory for a repo via git itself.

    Property-based (no gitdir-layout guessing): `git rev-parse --git-path
    hooks` returns the path git actually reads hooks from for that repo —
    the submodule's module gitdir for submodules, and the common .git/hooks
    for linked worktrees (which then dedupes with the root install).
    """
    result = run_git_command(["-C", repo_dir, "rev-parse", "--git-path", "hooks"])
    if not result:
        return None
    if os.path.isabs(result):
        return os.path.normpath(result)
    return os.path.normpath(os.path.join(repo_dir, result))


def _install_hooks_into(target_hooks_dir: str, source_dir: str, source_hooks: list[str]) -> None:
    """Copy source hooks into a target hooks directory, making them executable."""
    os.makedirs(target_hooks_dir, exist_ok=True)
    for hook_name in source_hooks:
        src = os.path.join(source_dir, hook_name)
        dst = os.path.join(target_hooks_dir, hook_name)
        if _hooks_match(src, dst):
            continue
        _copy_hook(src, dst)


def install_hooks() -> None:
    """Install git hooks from .opencode/hooks/ into every repo in the workspace.

    Covers the root repo and every linked repo discovered by collect_repo_info,
    including .git-file submodules (resolved via `rev-parse --git-path hooks`).
    Linked worktrees resolve to the common hooks dir and dedupe naturally.
    Reports failures to stderr.
    """
    source_dir = get_source_hooks_dir()
    if not source_dir:
        return

    source_hooks = [
        f
        for f in os.listdir(source_dir)
        if os.path.isfile(os.path.join(source_dir, f)) and not f.endswith(".sample")
    ]
    if not source_hooks:
        return

    installed_dirs: list[str] = []

    git_dir = _resolve_git_dir()
    if git_dir:
        parent_hooks_dir = os.path.join(git_dir, "hooks")
    else:
        parent_hooks_dir = os.path.join(os.getcwd(), ".git", "hooks")
    _install_hooks_into(parent_hooks_dir, source_dir, source_hooks)
    installed_dirs.append(parent_hooks_dir)

    linked_repos = collect_repo_info()
    for repo_entry in linked_repos:
        dir_name = repo_entry["path"]
        if dir_name == "." or not os.path.isdir(dir_name):
            continue

        target = _resolve_hooks_target(os.path.join(os.getcwd(), dir_name))
        if not target:
            continue
        normalized = os.path.normpath(target)
        if normalized in [os.path.normpath(d) for d in installed_dirs]:
            continue
        _install_hooks_into(normalized, source_dir, source_hooks)
        installed_dirs.append(normalized)

    if get_hooks_path():
        run_git_command(["config", "--unset", "core.hooksPath"])

    # Self-heal: session-init pollution in repos outside the coverage set is
    # removed and reported (#2544 items 3-4); the affected repos themselves
    # stay out of inventory. Side-effect reporting goes to stderr.
    for removal in self_heal_hooks():
        print(removal, file=sys.stderr)


def _coverage_hooks_dirs() -> set[str]:
    """Resolved hooks dirs of the coverage set: root + covered entries (#2544).

    Linked worktrees resolve to the same common hooks dir and dedupe here
    exactly as they dedupe out of double-install.
    """
    covered: set[str] = set()
    git_dir = _resolve_git_dir()
    if git_dir:
        covered.add(os.path.normpath(os.path.join(git_dir, "hooks")))
    else:
        covered.add(os.path.normpath(os.path.join(os.getcwd(), ".git", "hooks")))
    for repo_entry in collect_repo_info():
        dir_name = repo_entry["path"]
        if dir_name == ".":
            continue
        target = _resolve_hooks_target(os.path.join(os.getcwd(), dir_name))
        if target:
            covered.add(os.path.normpath(target))
    return covered


def _legacy_scan_candidates() -> list[str]:
    """Bounded filesystem enumeration mirroring the old scan's traversal
    exactly (#2544 item 3) — cleanup-only: installs nothing, inventories
    nothing.

    Every immediate child dir with a `.git` entry (descended into regardless
    of origin), plus every depth-2 dir with a `.git` entry inside them. The
    old installer only reached dirs with a parseable origin remote, so this
    bound is complete for cleanup.
    """
    cwd = os.getcwd()
    candidates: list[str] = []
    try:
        dir_entries = sorted(os.listdir(cwd))
    except OSError:
        return candidates
    for entry_name in dir_entries:
        entry_path = os.path.join(cwd, entry_name)
        if not os.path.isdir(entry_path):
            continue
        if not os.path.exists(os.path.join(entry_path, ".git")):
            continue
        candidates.append(entry_name)
        try:
            nested_entries = sorted(os.listdir(entry_path))
        except OSError:
            continue
        for nested_name in nested_entries:
            nested_path = os.path.join(entry_path, nested_name)
            if not os.path.isdir(nested_path):
                continue
            if os.path.exists(os.path.join(nested_path, ".git")):
                candidates.append(os.path.join(entry_name, nested_name))
    return candidates


def _blob_sha1(path: str) -> str | None:
    """Git blob sha1 of a file's content (the object id `git hash-object`
    would produce), or None on read failure."""
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError:
        return None
    header = f"blob {len(data)}\0".encode()
    return hashlib.sha1(header + data).hexdigest()


def _historical_hook_signatures(deck_root: str | None) -> dict[str, set[str]]:
    """Every hook name + content blob hash ever carried by `.opencode/hooks/`
    in the deck's git history (#2544 item 4).

    Prior installs pin the source content at install time; both the name set
    and the source content drift, so the historical set — not the current
    source set — classifies pollution. Foreign hooks (matching no historical
    name-plus-version) are untouched.
    """
    signatures: dict[str, set[str]] = {}
    if not deck_root or not os.path.isdir(deck_root):
        return signatures
    names_out = run_git_command([
        "-C", deck_root, "log", "--all", "--pretty=format:", "--name-only",
        "--", "hooks",
    ])
    if not names_out:
        return signatures
    names: set[str] = set()
    for line in names_out.splitlines():
        line = line.strip()
        if line.startswith("hooks/") and line.count("/") == 1:
            names.add(line.split("/", 1)[1])
    for name in sorted(names):
        shas: set[str] = set()
        commits = run_git_command([
            "-C", deck_root, "log", "--all", "--format=%H", "--", f"hooks/{name}",
        ])
        for sha in (commits or "").split():
            blob = run_git_command(["-C", deck_root, "rev-parse", f"{sha}:hooks/{name}"])
            if blob:
                shas.add(blob)
        if shas:
            signatures[name] = shas
    return signatures


def self_heal_hooks() -> list[str]:
    """Remove session-init pollution from repos outside the coverage set
    (#2544 items 3-4) and report removal events.

    A pollution file's name matches any hook name the hook source directory
    has ever carried, and its content matches any blob hash ever recorded at
    that name's source path. Classification is by the resolved hooks dir —
    cleanup never acts on a hooks dir resolving to a coverage-set repo's.
    Returns the removal-event lines (reported on stderr by the caller).
    """
    source_dir = get_source_hooks_dir()
    deck_root = os.path.dirname(source_dir) if source_dir else None
    signatures = _historical_hook_signatures(deck_root)
    if not signatures:
        return []
    coverage = _coverage_hooks_dirs()
    removals: list[str] = []
    seen: set[str] = set()
    for candidate in _legacy_scan_candidates():
        repo_dir = os.path.join(os.getcwd(), candidate)
        origin = run_git_command(["-C", repo_dir, "remote", "get-url", "origin"])
        if not origin:
            continue  # the old installer never reached origin-less repos
        owner, _repo, _platform = parse_repo_url(origin)
        if not owner:
            continue  # only parseable-origin repos were pollution-tested
        target = _resolve_hooks_target(repo_dir)
        if not target:
            continue
        normalized = os.path.normpath(target)
        if normalized in coverage or normalized in seen:
            continue  # coverage-set repos and deduped worktree aliases
        seen.add(normalized)
        if not os.path.isdir(normalized):
            continue
        for fname in sorted(os.listdir(normalized)):
            fpath = os.path.join(normalized, fname)
            if not os.path.isfile(fpath):
                continue
            hashes = signatures.get(fname)
            if not hashes:
                continue  # foreign hook name — untouched
            digest = _blob_sha1(fpath)
            if digest is None or digest not in hashes:
                continue  # foreign content — untouched
            try:
                os.remove(fpath)
            except OSError:
                continue
            removals.append(f"- {candidate}: removed {fname} (self-heal)")
    return removals


def collect_hook_inventory() -> list[str]:
    """Report-only hook inventory: trunk-check hook presence per repo.

    Verification and visibility only — never installs, never blocks.
    """
    source_dir = get_source_hooks_dir()
    lines: list[str] = []
    source_names: list[str] = []
    if source_dir:
        source_names = sorted(
            f
            for f in os.listdir(source_dir)
            if os.path.isfile(os.path.join(source_dir, f)) and not f.endswith(".sample")
        )
    names = ", ".join(source_names) if source_names else "none"
    lines.append(f"- hook source: .opencode/hooks/ ({names})")

    for repo in collect_repo_info():
        path = repo["path"]
        repo_dir = os.getcwd() if path == "." else os.path.join(os.getcwd(), path)
        target = _resolve_hooks_target(repo_dir)
        if not target or not os.path.isdir(target):
            lines.append(f"- {path}: hooks target not resolvable")
            continue
        states = []
        for name in source_names:
            dst = os.path.join(target, name)
            if not os.path.isfile(dst):
                states.append(f"{name}: MISSING")
            elif _hooks_match(os.path.join(source_dir, name), dst):
                states.append(f"{name}: ok")
            else:
                states.append(f"{name}: stale")
        lines.append(f"- {path}: {'; '.join(states) if states else 'no trunk hooks installed'}")
    return lines


def _extract_version_from_pyproject() -> str:
    """Extract version string from pyproject.toml, or return '0.1.0' as fallback."""
    pyproject_path = os.path.join(os.getcwd(), "pyproject.toml")
    if os.path.isfile(pyproject_path):
        try:
            with open(pyproject_path) as f:
                for line in f:
                    stripped = line.strip()
                    if stripped.startswith("version"):
                        parts = stripped.split("=", 1)
                        if len(parts) == 2:
                            return parts[1].strip().strip('"').strip("'")
        except OSError:
            pass
    return "0.1.0"





def detect_worktree() -> tuple[bool, str | None, str | None]:
    toplevel = run_git_command(["rev-parse", "--show-toplevel"])
    if not toplevel:
        return False, None, None

    git_path = os.path.join(toplevel, ".git")
    if os.path.isfile(git_path):
        try:
            with open(git_path) as f:
                content = f.read().strip()
            if content.startswith("gitdir: "):
                gitdir = content[8:]
                if not os.path.isabs(gitdir):
                    gitdir = os.path.join(toplevel, gitdir)
                worktrees_dir = os.path.dirname(os.path.abspath(gitdir))
                git_dir = os.path.dirname(worktrees_dir)
                if (
                    os.path.basename(git_dir) == ".git"
                    and os.path.basename(worktrees_dir) == "worktrees"
                ):
                    main_repo = os.path.dirname(git_dir)
                    return True, toplevel, main_repo
        except OSError:
            pass

    return False, None, None


def is_submodule_context() -> bool:
    toplevel = run_git_command(["rev-parse", "--show-toplevel"])
    if not toplevel:
        return False
    git_path = os.path.join(toplevel, ".git")
    if os.path.isfile(git_path):
        try:
            with open(git_path) as f:
                content = f.read().strip()
            if content.startswith("gitdir: "):
                gitdir = content[8:]
                if not os.path.isabs(gitdir):
                    gitdir = os.path.join(toplevel, gitdir)
                gitdir = os.path.normpath(gitdir)
                if ".git" in os.path.normpath(gitdir).split(
                    os.sep
                ) and "modules" in os.path.normpath(gitdir).split(os.sep):
                    return True
        except OSError:
            pass
    return False


def _add_to_gitignore(entry: str) -> bool:
    """Add an entry to .gitignore if not already present."""
    gitignore_path = os.path.join(os.getcwd(), ".gitignore")
    try:
        existing_lines: list[str] = []
        if os.path.isfile(gitignore_path):
            with open(gitignore_path) as f:
                existing_lines = f.read().splitlines()
        if entry in existing_lines:
            return True
        with open(gitignore_path, "a") as f:
            if existing_lines and existing_lines[-1] != "":
                f.write("\n")
            f.write(f"{entry}\n")
        return True
    except OSError:
        return False


CREDENTIAL_FILE_PATTERNS = [
    (".env", "Environment variables file"),
    (".streamlit/secrets.toml", "Streamlit secrets file"),
    (".streamlit/secrets.toml.production", "Streamlit production secrets file"),
]


def _check_credential_files_gitignored() -> list[str]:
    """Check credential files for gitignore coverage.

    Returns a list of warning messages for unprotected credential files.
    Empty list means all credential files are safe (gitignored or absent).
    """
    gitignore_path = os.path.join(os.getcwd(), ".gitignore")
    gitignore_entries: set[str] = set()
    if os.path.isfile(gitignore_path):
        try:
            with open(gitignore_path) as f:
                for line in f:
                    stripped = line.strip()
                    if stripped and not stripped.startswith("#"):
                        gitignore_entries.add(stripped)
        except OSError:
            pass

    unprotected: list[str] = []
    for filepath, description in CREDENTIAL_FILE_PATTERNS:
        full_path = os.path.join(os.getcwd(), filepath)
        if not os.path.isfile(full_path):
            continue
        if filepath in gitignore_entries or f"/{filepath}" in gitignore_entries:
            continue
        result = run_git_command(["check-ignore", filepath])
        if result is None:
            unprotected.append(
                f"WARNING: {filepath} ({description}) is NOT in .gitignore — secrets may be committed"
            )
    return unprotected


def run_guard_checks() -> list[str]:
    """Run guard checks silently. Returns list of problem descriptions."""
    problems: list[str] = []
    unprotected = _check_credential_files_gitignored()
    problems.extend(unprotected)
    return problems


def collect_issue_artifact_paths(repo_info: list[dict[str, str]]) -> list[str]:
    """Collect local .issues/ folder entries for each repo entry.

    Emits one vocabulary line stating that local artifacts for a qualified
    reference `repo#N` live at that repo's `issues:` path under `{N}/`
    (#2549 change 3), then one `git -C` pointer per repo whose store
    exists — or a setup hint naming `local-issues init` when the store is
    absent (fresh clones bootstrap the store on first init).
    """
    cwd = os.getcwd()
    entries: list[str] = [
        "- Local artifacts for a qualified reference repo#N live at that "
        "repo's `issues:` path under {N}/ — read from the store first; the "
        "remote issue body carries the structured summary; the store holds "
        "the full spec."
    ]
    for repo in repo_info:
        repo_path = repo["path"]
        # Skip .issues worktrees — they are the issue store, not repos
        # with their own issue folders
        if repo_path == ".issues" or repo_path.endswith("/.issues"):
            continue
        if repo_path == ".":
            issues_rel = ".issues/"
            issues_abs = os.path.join(cwd, ".issues")
        else:
            issues_rel = f"{repo_path}/.issues/"
            issues_abs = os.path.join(cwd, repo_path, ".issues")
        if os.path.exists(issues_abs):
            entries.append(f"- {issues_rel}: git -C {issues_rel}")
        else:
            entries.append(
                f"- {issues_rel}: absent — run ./.opencode/tools/local-issues init "
                "to bootstrap the issue store worktree"
            )
    return entries


def _worktree_porcelain_blocks(repo_dir: str) -> list[dict[str, str]]:
    """Linked-worktree records for a repo from `git worktree list --porcelain`.

    The first block is always the repo's main worktree — inside a submodule
    that row carries the module gitdir (`.git/modules/...`), not a real
    worktree path — so it is skipped; the module gitdir never reaches the
    displayed map (#1255, Git Display Quirks).
    """
    porcelain = run_git_command(["-C", repo_dir, "worktree", "list", "--porcelain"])
    if not porcelain:
        return []
    worktrees: list[dict[str, str]] = []
    for block in porcelain.split("\n\n")[1:]:  # skip main-worktree row
        if not block.strip():
            continue
        record: dict[str, str] = {}
        for line in block.splitlines():
            key, _, value = line.partition(" ")
            if key == "worktree":
                record["worktree"] = value
            elif key == "branch":
                record["branch"] = value.removeprefix("refs/heads/")
            elif key == "detached":
                record["detached"] = "1"
            elif key == "prunable":
                record["prunable"] = "1"
        if record.get("worktree"):
            worktrees.append(record)
    return worktrees


def _worktree_relpath(abs_path: str, project_root: str) -> str:
    """Project-root-relative display path, single-quoted on whitespace."""
    rel = os.path.relpath(abs_path, project_root)
    if any(ch.isspace() for ch in rel):
        rel = f"'{rel}'"
    return rel


def _repo_main_dir(repo_dir: str) -> str | None:
    """The repo's main-worktree directory (the project-relative anchor).

    A common git dir ending in `.git` marks a standard layout — the main
    worktree is its parent. Otherwise (a submodule's module gitdir, a
    worktree-scoped gitdir) fall back to the toplevel of `repo_dir` itself,
    which is the submodule's real checkout in the workspace layout.
    """
    common = run_git_command([
        "-C", repo_dir, "rev-parse", "--path-format=absolute", "--git-common-dir",
    ])
    if common and os.path.basename(os.path.normpath(common)) == ".git":
        return os.path.dirname(os.path.normpath(common))
    return run_git_command(["-C", repo_dir, "rev-parse", "--show-toplevel"])


def collect_worktree_map(repo_info: list[dict[str, str]]) -> list[str]:
    """Deviation-triggered worktree map lines (#1255).

    Standard worktree set for an enumerated repo R: R's main worktree (never
    displayed) plus its `.issues` store on `issues-data`. The map is emitted
    only when a deviation trigger holds for any enumerated repo: T1 a linked
    worktree outside the standard set, T2 any `prunable` registration, T3 any
    detached-HEAD linked worktree, T4 an `.issues` store on another branch.
    Facts only — rows carry relpath, branch, `current`, `prunable`; embedded
    non-submodule repos never appear (#2544 discovery stands).

    Returns the full section lines including the `## Worktree Map` title, or
    an empty list when no trigger holds.
    """
    cwd = os.getcwd()
    running_toplevel = run_git_command(["rev-parse", "--show-toplevel"])
    project_root = _repo_main_dir(cwd) or os.path.normpath(cwd)
    groups: list[tuple[str, list[str]]] = []
    triggered = False

    for entry in repo_info:
        path = entry["path"]
        repo_dir = cwd if path == "." else os.path.join(cwd, path)
        records = _worktree_porcelain_blocks(repo_dir)
        if not records:
            continue

        standard_abs = os.path.normpath(os.path.join(project_root, path, ".issues"))

        rows: list[str] = []
        for record in records:
            wt_path = record["worktree"]
            resolved = run_git_command(["-C", wt_path, "rev-parse", "--show-toplevel"])
            display_abs = os.path.normpath(resolved) if resolved else os.path.normpath(wt_path)
            branch = "[detached]" if record.get("detached") else f"[{record.get('branch', '')}]"
            is_standard = not record.get("detached") and display_abs == standard_abs
            flags = ""
            if running_toplevel and os.path.normpath(running_toplevel) == display_abs:
                flags += " current"
            if record.get("prunable"):
                flags += " prunable"
            rows.append(f"  {_worktree_relpath(display_abs, project_root)} {branch}{flags}")

            branch_name = record.get("branch", "")
            if (not is_standard
                    or record.get("prunable")
                    or record.get("detached")
                    or (is_standard and branch_name != "issues-data")):
                triggered = True

        owner = entry.get("owner", "(unknown)")
        repo = entry.get("repo", "(unknown)")
        header = f"{owner}/{repo}:" if path == "." else f"submodule {path}:"
        groups.append((header, rows))

    if not triggered:
        return []

    lines: list[str] = ["## Worktree Map", ""]
    for index, (header, rows) in enumerate(groups):
        if index:
            lines.append("")
        lines.append(header)
        lines.extend(rows)
    return lines


def get_agent_tools_help() -> str:
    """Run ./.opencode/tools/help and return tool listing or error message."""
    try:
        result = subprocess.run(
            [".opencode/tools/help"],
            capture_output=True,
            text=True,
            check=False,
            stdin=subprocess.DEVNULL,
            timeout=GIT_TIMEOUT,
            cwd=str(PROJECT_ROOT),
        )
        if result.returncode == 0:
            return result.stdout.rstrip("\n")
        return f"Error: tools/help exited with code {result.returncode}"
    except subprocess.TimeoutExpired:
        return f"Error: tools/help timed out after {GIT_TIMEOUT}s"
    except (subprocess.SubprocessError, OSError) as e:
        return f"Error: tools/help failed: {e}"


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--description":
        print("Session initialization script for AI agents.")
        return 0
    repo_info = collect_repo_info()

    user_name = get_user_name()
    user_email = get_user_email()

    guard_problems = run_guard_checks()
    if is_submodule_context():
        pass
    else:
        install_hooks()

    in_wt, wt_path, main_repo = detect_worktree()
    hooks_path = get_hooks_path()

    now = datetime.now().astimezone()
    print(f"Session started: {now.strftime('%A, %B %d, %Y at %I:%M %p')} {now.tzname()}")
    print("This session start time indicates your training data is extremely stale and always must be re-researched before making factual claims — never trust training data without live verification.")

    print(f"Developer: {user_name}")
    print(f"Email: {user_email}")

    if in_wt and wt_path and main_repo:
        print(f"Worktree: {wt_path}")

    if hooks_path:
        print(f"Git hooks: {hooks_path}")

    for problem in guard_problems:
        print(problem)

    # Emit ## CLI Auth Status section — only if at least one CLI is installed
    cli_status = check_cli_auth_status()
    if cli_status:
        print("## CLI Auth Status")
        for line in cli_status:
            print(line)

    # Emit ## Hook Inventory — report-only verification of the trunk-check hook
    print("## Hook Inventory (report-only)")
    for line in collect_hook_inventory():
        print(line)

    # Emit ## Local Issue Folders section
    issue_folders = collect_issue_artifact_paths(repo_info)
    print("## Local Issue Folders")
    for cmd in issue_folders:
        print(cmd)

    # Emit ## Worktree Map — deviation-triggered only (#1255)
    for line in collect_worktree_map(repo_info):
        print(line)

    # Emit unified ## Repo Information section
    # Fork stamps: local, untrusted context — informational only, never a
    # routing input. The probe itself is spawned detached, fire-and-forget;
    # any failure here is silent (no annotation, no warnings).
    fork_parents: dict[str, str] = {}
    try:
        fork_stamp.spawn_background_probe(repo_info)
        git_common_dir = fork_stamp.run_git_command_quiet(
            ["git", "rev-parse", "--git-common-dir"]
        )
        if git_common_dir:
            if not os.path.isabs(git_common_dir):
                git_common_dir = os.path.abspath(git_common_dir)
            fork_parents = fork_stamp.fresh_fork_parents(
                fork_stamp.load_stamps(git_common_dir)
            )
    except Exception:
        fork_parents = {}
    print("## Repo Information")
    print("Professional engineers route issue operations by matching affected file paths to the `path` prefix below, then using that entry's `owner` and `repo`. Amateurs default to root and route to the wrong repo.")
    for entry in repo_info:
        print(f"- path: {entry['path']}")
        print(f"  owner: {entry['owner']}")
        print(f"  repo: {entry['repo']}")
        print(f"  platform: {entry['platform']}")
        print(f"  url: {entry['url']}")
        # Store path for qualified-reference resolution: local artifacts
        # for repo#N live under {issues}/{N}/ (#2549 change 2)
        if entry["path"] == ".":
            print("  issues: .issues/")
        else:
            print(f"  issues: {entry['path']}/.issues/")
        parent = fork_parents.get(entry["url"])
        if parent:
            print(f"  fork_of: {parent}")

    # Emit project_root — absolute top-level git root for submodule-aware path resolution
    project_root = run_git_command(["rev-parse", "--show-toplevel"])
    print(f"project_root: {project_root}")

    # Emit ## Agent Tools section with tool listing
    tools_help = get_agent_tools_help()
    print("## Agent Tools")
    print(tools_help)

    return 0


if __name__ == "__main__":
    sys.exit(main())

