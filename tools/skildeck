#!/usr/bin/env -S uv run --script
# fmt: off
"exec" "uv" "run" "--script" "$0" "$@" # MUST GO BEFORE PEP 723 HEADER

# PEP 723 HEADER MUST BE AFTER BASH GUARD
# /// script
# requires-python = "~=3.12"
# dependencies = ["pyyaml>=6.0"]
# ///

# fmt: on
__doc__ = """DESCRIPTION: Skill deck analysis CLI. Lint skill and guideline files.
Usage: ./.opencode/tools/skildeck <action> [options]
Actions: lint, verify-acceptance, verify-issue, help
Example: ./.opencode/tools/skildeck lint
Example: ./.opencode/tools/skildeck verify-acceptance --spec tmp/spec.md
Example: ./.opencode/tools/skildeck verify-issue --issue 91 --body "issue body from github_issue_read"
"""

import os
import subprocess
import sys
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent
_path = Path(__file__).resolve().parent
while _path.name != ".opencode":
    parent = _path.parent
    if parent == _path:
        raise RuntimeError("Could not find .opencode/ directory")
    _path = parent
PROJECT_ROOT = _path.parent
IMPL_DIR = BASE_DIR / "impl" / "skildeck"

ACTIONS = {
    "lint": "skildeck-lint",
    "verify-acceptance": "skildeck-verify-acceptance",
    "verify-issue": "skildeck-verify-issue",
}

def _get_description(script_path: Path) -> str:
    import re

    try:
        text = script_path.read_text()
        m = re.search(r"DESCRIPTION:\s*(.+)", text)
        return m.group(1).strip() if m else ""
    except Exception:
        return ""

def _run_action(script: Path, forwarded_args: list[str], summary: str) -> int:
    result = subprocess.run(
        ["uv", "run", str(script)] + forwarded_args,
        capture_output=True,
        text=True,
        env={**os.environ, "OPENCODE_TOOLS_DISPATCHER": "1"},
    )
    if result.stdout:
        sys.stdout.write(result.stdout)
    if result.stderr:
        sys.stderr.write(result.stderr)
    if result.returncode == 0 and not result.stdout and not result.stderr:
        print(summary)
    return result.returncode

def main() -> None:
    args = sys.argv[1:]
    if len(sys.argv) == 2 and sys.argv[1] == "--description":
        print("Skill deck analysis CLI.")
        return
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        print("\nAvailable actions:")
        for action, script in ACTIONS.items():
            desc = _get_description(IMPL_DIR / script)
            print(
                f"  {action:<20} — {desc}"
                if desc
                else f"  {action:<20} → .opencode/tools/impl/skildeck/{script}"
            )
        print(f"\nCWD: {os.getcwd()}")
        sys.exit(0)

    action = args[0]

    if action not in ACTIONS:
        print(
            f"Error: unknown action {action!r}. Available: {', '.join(sorted(ACTIONS))}",
            file=sys.stderr,
        )
        sys.exit(1)

    script = IMPL_DIR / ACTIONS[action]
    if not script.exists():
        print(f"Error: action script not found: {script}", file=sys.stderr)
        sys.exit(1)

    sys.exit(
        _run_action(
            script, args[1:], f"OK: ./.opencode/tools/skildeck {action} completed."
        )
    )


if __name__ == "__main__":
    main()
